00008C                              166 CRSAVE   DS    16F                  STCTL 0,15 STORES ALL SIXTEEN
                                    167 *
                                    168 * ORB -- WORD ALIGNED.  THIRTY-TWO BYTES, NOT TWELVE: HERCULES FETCHES
                                    169 * SIZEOF(ORB)-1 UNCONDITIONALLY WHATEVER THE EXTENSION BIT SAYS, SO A
                                    170 * TWELVE-BYTE ORB AT THE END OF AN IMAGE TAKES AN ADDRESSING EXCEPTION
                                    171 * ON A FETCH THE ARCHITECTURE SAYS NEVER HAPPENS.
                                    172 *
0000CC                              173          DS    0F
0000CC 00000000                     174 ORB      DC    X'00000000'          INTERRUPTION PARAMETER, YOUR TAG
0000D0 00                           175          DC    X'00'                FLAG4: KEY 0 DISABLES CHANNEL KEY
                                    176 *                                   CHECKING ENTIRELY
0000D1 80                           177          DC    X'80'                FLAG5: F=1, FORMAT-1 CCWS
0000D2 80                           178          DC    X'80'                LPM -- MUST BE 80.  SSCH TESTS
                                    179 *                                   LPM AND PAM, AND PAM IS 80, SO 00
                                    180 *                                   IS CC 3 RATHER THAN "ANY PATH"
0000D3 00                           181          DC    X'00'                FLAG7
0000D4 00000160                     182          DC    A(MYCCW)             CCW ADDRESS, BIT 0 MUST BE ZERO
0000D8 0000000000000000             183          DC    5F'0'                PAD TO THIRTY-TWO
0000E0 0000000000000000
0000E8 00000000
                                    184 *
0000EC                              185          DS    0F
0000EC                              186 SCHIB    DS    XL52                 STSCH STORES 52, MSCH READS 28
000120                              187          DS    0F
000120                              188 IRB      DS    XL64                 TSCH STORES ALL 64
                                    189 *
                                    190 * THE CCW MUST BE ON A DOUBLEWORD BOUNDARY OR IT IS A CHANNEL PROGRAM
                                    191 * CHECK -- A DIFFERENT RULE FROM THE ORB, SCHIB AND IRB, WHICH NEED
                                    192 * ONLY A WORD.
                                    193 *
000160                              194          DS    0D
000160 09                           195 MYCCW    DC    X'09'                WRITE WITH AUTO CARRIER RETURN
000161 20                           196          DC    X'20'                SLI, SUPPRESS INCORRECT LENGTH
