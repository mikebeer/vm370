000048                              111          DS    0F
000048 00010000                     112 SSIDW    DC    X'00010000'          X'0001' || SUBCHANNEL NUMBER
00004C 00003001                     113 CR1VAL   DC    X'00003001'          STO X'3000', STL 1 = 32 ENTRIES
000050                              114 PARM     DS    F
000054                              115 MASKSAVE DS    X
000058                              116          DS    0F
000058                              117 CRSAVE   DS    16F                  STCTL 0,15 STORES ALL SIXTEEN
                                    118 *
                                    119 * ORB -- WORD ALIGNED.  THIRTY-TWO BYTES, NOT TWELVE: HERCULES FETCHES
                                    120 * SIZEOF(ORB)-1 UNCONDITIONALLY WHATEVER THE EXTENSION BIT SAYS, SO A
                                    121 * TWELVE-BYTE ORB AT THE END OF AN IMAGE TAKES AN ADDRESSING EXCEPTION
                                    122 * ON A FETCH THE ARCHITECTURE SAYS NEVER HAPPENS.
                                    123 *
000098                              124          DS    0F
000098 00000000                     125 ORB      DC    X'00000000'          INTERRUPTION PARAMETER, YOUR TAG
00009C 00                           126          DC    X'00'                FLAG4: KEY 0 DISABLES CHANNEL KEY
                                    127 *                                   CHECKING ENTIRELY
00009D 80                           128          DC    X'80'                FLAG5: F=1, FORMAT-1 CCWS
00009E 80                           129          DC    X'80'                LPM -- MUST BE 80.  SSCH TESTS
                                    130 *                                   LPM AND PAM, AND PAM IS 80, SO 00
                                    131 *                                   IS CC 3 RATHER THAN "ANY PATH"
00009F 00                           132          DC    X'00'                FLAG7
0000A0 00000130                     133          DC    A(MYCCW)             CCW ADDRESS, BIT 0 MUST BE ZERO
0000A4 0000000000000000             134          DC    5F'0'                PAD TO THIRTY-TWO
0000AC 0000000000000000
0000B4 00000000
                                    135 *
0000B8                              136          DS    0F
0000B8                              137 SCHIB    DS    XL52                 STSCH STORES 52, MSCH READS 28
0000EC                              138          DS    0F
0000EC                              139 IRB      DS    XL64                 TSCH STORES ALL 64
                                    140 *
                                    141 * THE CCW MUST BE ON A DOUBLEWORD BOUNDARY OR IT IS A CHANNEL PROGRAM
                                    142 * CHECK -- A DIFFERENT RULE FROM THE ORB, SCHIB AND IRB, WHICH NEED
                                    143 * ONLY A WORD.
                                    144 *
000130                              145          DS    0D
000130 09                           146 MYCCW    DC    X'09'                WRITE WITH AUTO CARRIER RETURN
000131 20                           147          DC    X'20'                SLI, SUPPRESS INCORRECT LENGTH
000132 0006                         148          DC    AL2(L'MSG)
000134 00000138                     149          DC    A(MSG)
000138 E7C1E3C5E2E3                 150 MSG      DC    C'XATEST'
                                    151 *
000140                              152          LTORG
                                    153 *
                                    154          END
