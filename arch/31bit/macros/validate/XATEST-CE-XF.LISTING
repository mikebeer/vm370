                                     79          TPI   PARM            *    B236
000026                               80+         DS    0H
000026 B236F04E                      81+         DC    X'B236',S(PARM)
                                     82          STCRW PARM            *    B239
00002A                               83+         DS    0H
00002A B239F04E                      84+         DC    X'B239',S(PARM)
                                     85 *
                                     86          BSM   R1,0            *    0B10  proven by execution
00002E                               87+         DS    0H
00002E 0B10                          88+         DC    X'0B',AL1((R1)*16+(0))
                                     89          BSM   0,R4            *    0B04  proven by execution
000030                               90+         DS    0H
000030 0B04                          91+         DC    X'0B',AL1((0)*16+(R4))
                                     92          BASSM R14,R15         *    0CEF
000032                               93+         DS    0H
000032 0CEF                          94+         DC    X'0C',AL1((R14)*16+(R15))
                                     95 *
                                     96 * THESE NEED NO MACRO -- THE ASSEMBLER ALREADY KNOWS THEM, AND IF ANY
                                     97 * OF THE FOUR FAILS TO ASSEMBLE THEN THE PROBLEM IS THE ASSEMBLER
                                     98 * LEVEL RATHER THAN THE MACLIB.
                                     99 *
000034 AD04 F052      00054         100          STOSM MASKSAVE,X'04'  *    AD04  DAT on
000038 ACFB F052      00054         101          STNSM MASKSAVE,X'FB'  *    ACFB  DAT off
00003C B711 F04A      0004C         102          LCTL  1,1,CR1VAL      *    B711
000040 B60F F056      00058         103          STCTL 0,15,CRSAVE     *    B60F
                                    104 *
000044 07FE                         105          BR    R14
                                    106 *
                                    107 *---------------------------------------------------------------------*
                                    108 * OPERANDS.  THE ALIGNMENT RULES DIFFER WITHIN ONE SEQUENCE AND THE   *
                                    109 * MACHINE ENFORCES EACH OF THEM SEPARATELY.                           *
                                    110 *---------------------------------------------------------------------*
