  p = p || "         rest))" || '0a'x
  p = p || "      ((%lp-is w ""ACROSS"")" || '0a'x
  p = p || "       (let ((v (gensym)) (i (gensym)))" || '0a'x
  p = p || "         (%lp-bind v (cadr rest))" || '0a'x
  p = p || "         (%lp-bind i 0)" || '0a'x
  p = p || "         (%lp-bindvars var)" || '0a'x
  p = p || "         (%lp-head (list 'when (list '>= i (list 'length v)) *lp-end*))" || '0a'x
  p = p || "         (%lp-assign var (list 'aref v i))" || '0a'x
  p = p || "         (%lp-step (list 'setq i (list '1+ i)))" || '0a'x
  p = p || "         (cddr rest)))" || '0a'x
  p = p || "      ((%lp-is w ""="")" || '0a'x
  p = p || "       (let ((init (cadr rest)))" || '0a'x
  p = p || "         (setq rest (cddr rest))" || '0a'x
  p = p || "         (cond ((%lp-is (car rest) ""THEN"")" || '0a'x
  p = p || "                (%lp-bind var init)" || '0a'x
  p = p || "                (%lp-step (list 'setq var (cadr rest)))" || '0a'x
  p = p || "                (cddr rest))" || '0a'x
  p = p || "               (t (%lp-bindvars var)" || '0a'x
  p = p || "                  (%lp-assign var init)" || '0a'x
  p = p || "                  rest))))" || '0a'x
  p = p || "      ((%lp-is w ""BEING"")" || '0a'x
