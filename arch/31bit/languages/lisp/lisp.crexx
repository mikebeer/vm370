/* MAPCAR */
pf81: procedure = .int
  arg expose av = .int[], n = .int
  fn = fnof(av[1])
  if unw <> 0 then return 1
  nl = n - 1
  ls = .int[]
  do i = 1 to nl
    ls[i] = av[i + 1]
  end
  r = 1
  b = .int[]
  do forever
    do i = 1 to nl
      if iscons(ls[i]) = 0 then do
        return nreverse(r)
      end
      b[i] = ccar[ls[i]]
      ls[i] = ccdr[ls[i]]
    end
    v = applyfn(fn, b, nl)
    if unw <> 0 then return 1
    r = cons(v, r)
  end
  return 1
  return 1

