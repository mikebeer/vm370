  if id = 223 then return pf223(av, n)
  return 1

callprim: procedure = .int
  arg id = .int, expose av = .int[], n = .int
  g = (id - 1) / 30
  if g = 0 then return primg0(id, av, n)
  if g = 1 then return primg1(id, av, n)
  if g = 2 then return primg2(id, av, n)
  if g = 3 then return primg3(id, av, n)
  if g = 4 then return primg4(id, av, n)
  if g = 5 then return primg5(id, av, n)
  if g = 6 then return primg6(id, av, n)
  if g = 7 then return primg7(id, av, n)
  return 1

