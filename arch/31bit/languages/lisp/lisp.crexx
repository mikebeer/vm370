/* SORT STABLE-SORT */
pf101: procedure = .int
  arg expose av = .int[], n = .int
  pf = fnof(av[2])
  if unw <> 0 then return 1
  kf = kwfn(av, n, 3, 'KEY')
  a = .int[]
  k = seq2arr(av[1], a)
  call msort a, k, pf, kf
  if unw <> 0 then return 1
  if av[1] > 0 then do
    if ctag[av[1]] = 9 then do
      do i = 1 to k
        vdat[cext[av[1]] + i - 1] = a[i]
      end
      return av[1]
    end
  end
  return arr2seq(av[1], a, k)
  return 1

/* ELT AREF SVREF CHAR SCHAR */
pf102: procedure = .int
  arg expose av = .int[], n = .int
  x = av[1]
  i = toint(av[2])
  if unw <> 0 then return 1
  if x = 1 | iscons(x) = 1 then do
    do while i > 0 & iscons(x) = 1
      x = ccdr[x]
      i = i - 1
    end
    if iscons(x) = 0 then return lerror('index out of bounds')
    return ccar[x]
  end
  if x > 0 then do
    if ctag[x] = 9 then do
      if i < 0 | i >= ccdr[x] then return lerror('index ' || i || ' is out of bounds for the vector')
      return vdat[cext[x] + i]
    end
    if ctag[x] = 4 then do
      if i < 0 | i >= length(cstr[x]) then return lerror('index ' || i || ' is out of bounds for the string')
      return mkchar(c2d(substr(cstr[x], i + 1, 1)))
    end
  end
  return lerrk('TYPE-ERROR', 'the value ' || printobj(x, 1) || ' is not a sequence')
  return 1

/* SUBSEQ */
pf103: procedure = .int
  arg expose av = .int[], n = .int
  en = -1
  if n = 3 then do
    if av[3] <> 1 then en = toint(av[3])
  end
  return subseqn(av[1], toint(av[2]), en)
  return 1

/* COPY-SEQ */
pf104: procedure = .int
  arg expose av = .int[], n = .int
  return subseqn(av[1], 0, -1)
  return 1

/* VECTOR */
pf105: procedure = .int
  arg expose av = .int[], n = .int
  return mkvec(av, n)
  return 1

/* MAKE-ARRAY */
pf106: procedure = .int
  arg expose av = .int[], n = .int
  sz = 0
  if av[1] > 0 | av[1] = 1 then do
    if iscons(av[1]) = 1 then sz = toint(ccar[av[1]])
  end
  else sz = toint(av[1])
  init = mkint(0)
  j = kwidx(av, n, 2, 'INITIAL-ELEMENT')
  if j > 0 then init = av[j]
  v = mkvecn(sz, init)
  j = kwidx(av, n, 2, 'INITIAL-CONTENTS')
  if j > 0 then do
    a = .int[]
    k = seq2arr(av[j], a)
    do i = 1 to k
      vdat[cext[v] + i - 1] = a[i]
    end
  end
  j = kwidx(av, n, 2, 'FILL-POINTER')
  if j > 0 then do
    if av[j] < 0 then ccdr[v] = intval(av[j])
    else if av[j] = 2 then ccdr[v] = sz
    else ccdr[v] = 0
  end
  return v
  return 1

/* VECTOR-PUSH */
pf107: procedure = .int
  arg expose av = .int[], n = .int
  v = av[2]
  cap = trunc(cnum[v]) as .int
  if ccdr[v] >= cap then return 1
  vdat[cext[v] + ccdr[v]] = av[1]
  ccdr[v] = ccdr[v] + 1
  return mkint(ccdr[v] - 1)
  return 1

/* VECTOR-PUSH-EXTEND */
pf108: procedure = .int
  arg expose av = .int[], n = .int
  v = av[2]
  cap = trunc(cnum[v]) as .int
  if ccdr[v] >= cap then do
    nc = cap * 2
    if nc < 4 then nc = 4
    nb = nvdat + 1
    do i = 0 to ccdr[v] - 1
      vdat[nb + i] = vdat[cext[v] + i]
    end
    nvdat = nvdat + nc
    cext[v] = nb
    cnum[v] = nc * 1.0
  end
  vdat[cext[v] + ccdr[v]] = av[1]
  ccdr[v] = ccdr[v] + 1
  return mkint(ccdr[v] - 1)
  return 1

/* VECTOR-POP */
pf109: procedure = .int
  arg expose av = .int[], n = .int
  v = av[1]
  if ccdr[v] = 0 then return lerror('nothing to pop')
  ccdr[v] = ccdr[v] - 1
  return vdat[cext[v] + ccdr[v]]
  return 1

/* FILL */
pf110: procedure = .int
  arg expose av = .int[], n = .int
  x = av[1]
  if x > 0 then do
    if ctag[x] = 9 then do
      do i = 0 to ccdr[x] - 1
        vdat[cext[x] + i] = av[2]
      end
      return x
    end
  end
  l = x
  do while iscons(l) = 1
    ccar[l] = av[2]
    l = ccdr[l]
  end
  return x
  return 1

/* CONCATENATE */
pf111: procedure = .int
  arg expose av = .int[], n = .int
  a = .int[]
  k = 0
  do i = 2 to n
    b = .int[]
    m = seq2arr(av[i], b)
    do j = 1 to m
      k = k + 1
      a[k] = b[j]
    end
  end
  ty = cstr[av[1]]
  if ty = 'STRING' then return arr2seq(mkstr(''), a, k)
  if ty = 'LIST' then return arr2list(a, 1, k)
  return mkvec(a, k)
  return 1

/* COERCE */
pf112: procedure = .int
  arg expose av = .int[], n = .int
  x = av[1]
  ty = cstr[av[2]]
  if ty = 'LIST' then do
    a = .int[]
    k = seq2arr(x, a)
    return arr2list(a, 1, k)
  end
  if ty = 'VECTOR' | ty = 'SIMPLE-VECTOR' then do
    a = .int[]
    k = seq2arr(x, a)
    return mkvec(a, k)
  end
  if ty = 'STRING' then do
    if isstring(x) = 1 then return x
    a = .int[]
    k = seq2arr(x, a)
    return arr2seq(mkstr(''), a, k)
  end
  if ty = 'FLOAT' | ty = 'DOUBLE-FLOAT' | ty = 'SINGLE-FLOAT' then return mkfloat(fval(x))
  if ty = 'INTEGER' then return mkint(toint(x))
  if ty = 'CHARACTER' then return x
  if ty = 'FUNCTION' then return fnof(x)
  return x
  return 1

/* MAX */
pf113: procedure = .int
  arg expose av = .int[], n = .int
  r = av[1]
  do i = 2 to n
    if numcmp(av[i], r) > 0 then r = av[i]
  end
  if unw <> 0 then return 1
  return r
  return 1

/* MIN */
pf114: procedure = .int
  arg expose av = .int[], n = .int
  r = av[1]
  do i = 2 to n
    if numcmp(av[i], r) < 0 then r = av[i]
  end
  if unw <> 0 then return 1
  return r
  return 1

/* ABS */
pf115: procedure = .int
  arg expose av = .int[], n = .int
  if numcmp(av[1], mkint(0)) < 0 then return numneg(av[1])
  return av[1]
  return 1

/* SIGNUM */
pf116: procedure = .int
  arg expose av = .int[], n = .int
  c = numcmp(av[1], mkint(0))
  if isfloat(av[1]) = 1 then return mkfloat(c * 1.0)
  return mkint(c)
  return 1

/* FLOOR */
pf117: procedure = .int
  arg expose av = .int[], n = .int
  a = av[1]
  if n = 2 then b = av[2]
  else b = mkint(1)
  if a < 0 & b < 0 then do
    x = intval(a)
    y = intval(b)
    if y = 0 then return lerrk('DIVISION-BY-ZERO', 'arithmetic error DIVISION-BY-ZERO signalled')
    q = x / y
    if x % y <> 0 & ((x < 0) <> (y < 0)) then q = q - 1
    mvlist = list2(mkint(q), mkint(x - q * y))
    return mkint(q)
  end
  if isnum(a) = 0 then return notnum(a)
  if isnum(b) = 0 then return notnum(b)
  fx = fval(a) / fval(b)
  q = trunc(fx) as .int
  if q > fx then q = q - 1
  mvlist = list2(mkint(q), mkfloat(fval(a) - q * fval(b)))
  return mkint(q)
  return 1

/* CEILING */
pf118: procedure = .int
  arg expose av = .int[], n = .int
  a = av[1]
  if n = 2 then b = av[2]
  else b = mkint(1)
  if a < 0 & b < 0 then do
    x = intval(a)
    y = intval(b)
    if y = 0 then return lerrk('DIVISION-BY-ZERO', 'arithmetic error DIVISION-BY-ZERO signalled')
    q = x / y
    if x % y <> 0 & ((x < 0) = (y < 0)) then q = q + 1
    mvlist = list2(mkint(q), mkint(x - q * y))
    return mkint(q)
  end
  if isnum(a) = 0 then return notnum(a)
  if isnum(b) = 0 then return notnum(b)
  fx = fval(a) / fval(b)
  q = trunc(fx) as .int
  if q < fx then q = q + 1
  mvlist = list2(mkint(q), mkfloat(fval(a) - q * fval(b)))
  return mkint(q)
  return 1

/* TRUNCATE */
pf119: procedure = .int
  arg expose av = .int[], n = .int
  a = av[1]
  if n = 2 then b = av[2]
  else b = mkint(1)
  if a < 0 & b < 0 then do
    x = intval(a)
    y = intval(b)
    if y = 0 then return lerrk('DIVISION-BY-ZERO', 'arithmetic error DIVISION-BY-ZERO signalled')
    q = x / y
    mvlist = list2(mkint(q), mkint(x - q * y))
    return mkint(q)
  end
  if isnum(a) = 0 then return notnum(a)
  if isnum(b) = 0 then return notnum(b)
  fx = fval(a) / fval(b)
  q = trunc(fx) as .int
  mvlist = list2(mkint(q), mkfloat(fval(a) - q * fval(b)))
  return mkint(q)
  return 1

/* ROUND */
pf120: procedure = .int
  arg expose av = .int[], n = .int
  a = av[1]
  if n = 2 then b = av[2]
  else b = mkint(1)
  if isnum(a) = 0 then return notnum(a)
  if isnum(b) = 0 then return notnum(b)
  x = fval(a) / fval(b)
  q = trunc(x) as .int
  fr = x - q
  if fr < 0.0 then fr = 0.0 - fr
  if fr > 0.5 then do
    if x > 0.0 then q = q + 1
    else q = q - 1
  end
  else if fr = 0.5 then do
    if q % 2 <> 0 then do
      if x > 0.0 then q = q + 1
      else q = q - 1
    end
  end
  mvlist = list2(mkint(q), mkfloat(fval(a) - q * fval(b)))
  return mkint(q)
  return 1

/* MOD */
pf121: procedure = .int
  arg expose av = .int[], n = .int
  a = av[1]
  b = av[2]
  if a < 0 & b < 0 then do
    x = intval(a)
    y = intval(b)
    if y = 0 then return lerrk('DIVISION-BY-ZERO', 'arithmetic error DIVISION-BY-ZERO signalled')
    q = x / y
    if x % y <> 0 & ((x < 0) <> (y < 0)) then q = q - 1
    return mkint(x - q * y)
  end
  if isnum(a) = 0 then return notnum(a)
  if isnum(b) = 0 then return notnum(b)
  fx = fval(a) / fval(b)
  q = trunc(fx) as .int
  if q > fx then q = q - 1
  return mkfloat(fval(a) - q * fval(b))
  return 1

/* REM */
pf122: procedure = .int
  arg expose av = .int[], n = .int
  a = av[1]
  b = av[2]
  if a < 0 & b < 0 then do
    y = intval(b)
    if y = 0 then return lerrk('DIVISION-BY-ZERO', 'arithmetic error DIVISION-BY-ZERO signalled')
    return mkint(intval(a) % y)
  end
  if isnum(a) = 0 then return notnum(a)
  if isnum(b) = 0 then return notnum(b)
  x = fval(a) / fval(b)
  q = trunc(x) as .int
  return mkfloat(fval(a) - q * fval(b))
  return 1

/* SQRT */
pf123: procedure = .int
  arg expose av = .int[], n = .int
  if isnum(av[1]) = 0 then return notnum(av[1])
  x = fval(av[1])
  if x < 0.0 then return lerrk('ERROR', 'SQRT of a negative number is not supported')
  return mkfloat(lsqrt(x))
  return 1

/* ISQRT */
pf124: procedure = .int
  arg expose av = .int[], n = .int
  k = toint(av[1])
  if k < 0 then return lerror('ISQRT of a negative number')
  r = trunc(lsqrt(k * 1.0)) as .int
  do while r * r > k
    r = r - 1
  end
  do while (r + 1) * (r + 1) <= k
    r = r + 1
  end
  return mkint(r)
  return 1

/* EXP */
pf125: procedure = .int
  arg expose av = .int[], n = .int
  return mkfloat(lexp(fval(av[1])))
  return 1

/* LOG */
pf126: procedure = .int
  arg expose av = .int[], n = .int
  x = fval(av[1])
  if x <= 0.0 then return lerrk('DIVISION-BY-ZERO', 'LOG of a non-positive number')
  if n = 2 then return mkfloat(lln(x) / lln(fval(av[2])))
  return mkfloat(lln(x))
  return 1

/* SIN */
pf127: procedure = .int
  arg expose av = .int[], n = .int
  return mkfloat(lsin(fval(av[1])))
  return 1

/* COS */
pf128: procedure = .int
  arg expose av = .int[], n = .int
  return mkfloat(lcos(fval(av[1])))
  return 1

/* TAN */
pf129: procedure = .int
  arg expose av = .int[], n = .int
  x = fval(av[1])
  return mkfloat(lsin(x) / lcos(x))
  return 1

/* ATAN */
pf130: procedure = .int
  arg expose av = .int[], n = .int
  if n = 1 then return mkfloat(latan(fval(av[1])))
  y = fval(av[1])
  x = fval(av[2])
  pi = 3.14159265358979323846
  if x > 0.0 then return mkfloat(latan(y / x))
  if x < 0.0 then do
    if y >= 0.0 then return mkfloat(latan(y / x) + pi)
    return mkfloat(latan(y / x) - pi)
  end
  if y > 0.0 then return mkfloat(pi / 2.0)
  if y < 0.0 then return mkfloat(0.0 - pi / 2.0)
  return mkfloat(0.0)
  return 1

/* EXPT */
pf131: procedure = .int
  arg expose av = .int[], n = .int
  b = av[1]
  e = av[2]
  if b < 0 & e < 0 then do
    k = intval(e)
    if k >= 0 then return mkint(ipow(intval(b), k))
    return mkfloat(1.0 / ipow(intval(b), 0 - k))
  end
  if isnum(b) = 0 then return notnum(b)
  if isnum(e) = 0 then return notnum(e)
  if e < 0 then do
    k = intval(e)
    x = fval(b)
    r = 1.0
    m = k
    if m < 0 then m = 0 - m
    do m
      r = r * x
    end
    if k < 0 then r = 1.0 / r
    return mkfloat(r)
  end
  x = fval(b)
  if x = 0.0 then return mkfloat(0.0)
  if x < 0.0 then return lerrk('ERROR', 'EXPT of a negative number to a float power is not supported')
  return mkfloat(lexp(fval(e) * lln(x)))
  return 1

/* FLOAT */
pf132: procedure = .int
  arg expose av = .int[], n = .int
  if isnum(av[1]) = 0 then return notnum(av[1])
  return mkfloat(fval(av[1]))
  return 1

/* GCD */
pf133: procedure = .int
  arg expose av = .int[], n = .int
  r = 0
  do i = 1 to n
    a = toint(av[i])
    if a < 0 then a = 0 - a
    b = r
    do while a <> 0
      t = b % a
      b = a
      a = t
    end
    r = b
  end
  return mkint(r)
  return 1

/* LCM */
pf134: procedure = .int
  arg expose av = .int[], n = .int
  r = 1
  do i = 1 to n
    a = toint(av[i])
    if a < 0 then a = 0 - a
    if a = 0 then return mkint(0)
    x = r
    y = a
    do while y <> 0
      t = x % y
      x = y
      y = t
    end
    r = r / x * a
  end
  return mkint(r)
  return 1

/* RANDOM */
pf135: procedure = .int
  arg expose av = .int[], n = .int
  x = av[1]
  if x < 0 then do
    k = intval(x)
    if k <= 0 then return lerror('RANDOM needs a positive limit')
    return mkint(nextrand() % k)
  end
  return mkfloat(nextrand() / 2147483648.0 * fval(x))
  return 1

/* ASH */
pf136: procedure = .int
  arg expose av = .int[], n = .int
  a = toint(av[1])
  s = toint(av[2])
  if s >= 0 then return mkint(a * ipow(2, s))
  d = ipow(2, 0 - s)
  q = a / d
  if a % d <> 0 & a < 0 then q = q - 1
  return mkint(q)
  return 1

/* LOGAND */
pf137: procedure = .int
  arg expose av = .int[], n = .int
  r = -1
  if n = 0 then return mkint(-1)
  r = toint(av[1])
  do i = 2 to n
    r = bitop(r, toint(av[i]), 1)
  end
  return mkint(r)
  return 1

/* LOGIOR */
pf138: procedure = .int
  arg expose av = .int[], n = .int
  if n = 0 then return mkint(0)
  r = toint(av[1])
  do i = 2 to n
    r = bitop(r, toint(av[i]), 2)
  end
  return mkint(r)
  return 1

/* LOGXOR */
pf139: procedure = .int
  arg expose av = .int[], n = .int
  if n = 0 then return mkint(0)
  r = toint(av[1])
  do i = 2 to n
    r = bitop(r, toint(av[i]), 3)
  end
  return mkint(r)
  return 1

/* LOGNOT */
pf140: procedure = .int
  arg expose av = .int[], n = .int
  return mkint(0 - toint(av[1]) - 1)
  return 1

/* PARSE-INTEGER */
pf141: procedure = .int
  arg expose av = .int[], n = .int
  j = kwidx(av, n, 2, 'JUNK-ALLOWED')
  junk = 0
  if j > 0 then do
    if av[j] <> 1 then junk = 1
  end
  return parseint(strof(av[1]), junk)
  return 1

/* CHAR-CODE CHAR-INT */
pf142: procedure = .int
  arg expose av = .int[], n = .int
  return mkint(cext[av[1]])
  return 1

/* CODE-CHAR */
pf143: procedure = .int
  arg expose av = .int[], n = .int
  return mkchar(toint(av[1]))
  return 1

/* CHAR-UPCASE */
pf144: procedure = .int
  arg expose av = .int[], n = .int
  c = cext[av[1]]
  if c >= 97 & c <= 122 then c = c - 32
  return mkchar(c)
  return 1

/* CHAR-DOWNCASE */
pf145: procedure = .int
  arg expose av = .int[], n = .int
  c = cext[av[1]]
  if c >= 65 & c <= 90 then c = c + 32
  return mkchar(c)
  return 1

/* ALPHA-CHAR-P */
pf146: procedure = .int
  arg expose av = .int[], n = .int
  return truth(isalpha(cext[av[1]]))
  return 1

/* DIGIT-CHAR-P */
pf147: procedure = .int
  arg expose av = .int[], n = .int
  c = cext[av[1]]
  if c >= 48 & c <= 57 then return mkint(c - 48)
  return 1
  return 1

/* ALPHANUMERICP */
pf148: procedure = .int
  arg expose av = .int[], n = .int
  c = cext[av[1]]
  if isalpha(c) = 1 | (c >= 48 & c <= 57) then return 2
  return 1
  return 1

/* UPPER-CASE-P */
pf149: procedure = .int
  arg expose av = .int[], n = .int
  c = cext[av[1]]
  return truth(c >= 65 & c <= 90)
  return 1

/* LOWER-CASE-P */
pf150: procedure = .int
  arg expose av = .int[], n = .int
  c = cext[av[1]]
  return truth(c >= 97 & c <= 122)
  return 1

/* DIGIT-CHAR */
pf151: procedure = .int
  arg expose av = .int[], n = .int
  d = toint(av[1])
  return mkchar(c2d(substr('0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ', d + 1, 1)))
  return 1

/* CHAR= */
pf152: procedure = .int
  arg expose av = .int[], n = .int
  do i = 1 to n - 1
    if cext[av[i]] <> cext[av[i + 1]] then return 1
  end
  return 2
  return 1

/* CHAR/= */
pf153: procedure = .int
  arg expose av = .int[], n = .int
  return truth(cext[av[1]] <> cext[av[2]])
  return 1

/* CHAR< */
pf154: procedure = .int
  arg expose av = .int[], n = .int
  do i = 1 to n - 1
    if cext[av[i]] >= cext[av[i + 1]] then return 1
  end
  return 2
  return 1

/* CHAR> */
pf155: procedure = .int
  arg expose av = .int[], n = .int
  do i = 1 to n - 1
    if cext[av[i]] <= cext[av[i + 1]] then return 1
  end
  return 2
  return 1

/* CHAR<= */
pf156: procedure = .int
  arg expose av = .int[], n = .int
  do i = 1 to n - 1
    if cext[av[i]] > cext[av[i + 1]] then return 1
  end
  return 2
  return 1

/* CHAR>= */
pf157: procedure = .int
  arg expose av = .int[], n = .int
  do i = 1 to n - 1
    if cext[av[i]] < cext[av[i + 1]] then return 1
  end
  return 2
  return 1

/* CHAR-EQUAL */
pf158: procedure = .int
  arg expose av = .int[], n = .int
  do i = 1 to n - 1
    if upper(d2c(cext[av[i]])) <> upper(d2c(cext[av[i + 1]])) then return 1
  end
  return 2
  return 1

/* STRING */
pf159: procedure = .int
  arg expose av = .int[], n = .int
  return mkstr(strof(av[1]))
  return 1

/* STRING= */
pf160: procedure = .int
  arg expose av = .int[], n = .int
  return truth(strof(av[1]) == strof(av[2]))
  return 1

/* STRING-EQUAL */
pf161: procedure = .int
  arg expose av = .int[], n = .int
  return truth(upper(strof(av[1])) == upper(strof(av[2])))
  return 1

/* STRING< */
pf162: procedure = .int
  arg expose av = .int[], n = .int
  if strcmp(strof(av[1]), strof(av[2])) < 0 then return 2
  return 1
  return 1

/* STRING> */
pf163: procedure = .int
  arg expose av = .int[], n = .int
  if strcmp(strof(av[1]), strof(av[2])) > 0 then return 2
  return 1
  return 1

/* STRING<= */
pf164: procedure = .int
  arg expose av = .int[], n = .int
  if strcmp(strof(av[1]), strof(av[2])) <= 0 then return 2
  return 1
  return 1

/* STRING>= */
pf165: procedure = .int
  arg expose av = .int[], n = .int
  if strcmp(strof(av[1]), strof(av[2])) >= 0 then return 2
  return 1
  return 1

/* STRING-LESSP */
pf166: procedure = .int
  arg expose av = .int[], n = .int
  if strcmp(upper(strof(av[1])), upper(strof(av[2]))) < 0 then return 2
  return 1
  return 1

/* STRING-GREATERP */
pf167: procedure = .int
  arg expose av = .int[], n = .int
  if strcmp(upper(strof(av[1])), upper(strof(av[2]))) > 0 then return 2
  return 1
  return 1

/* STRING-UPCASE */
pf168: procedure = .int
  arg expose av = .int[], n = .int
  return mkstr(upper(strof(av[1])))
  return 1

/* STRING-DOWNCASE */
pf169: procedure = .int
  arg expose av = .int[], n = .int
  return mkstr(lower(strof(av[1])))
  return 1

/* STRING-CAPITALIZE */
pf170: procedure = .int
  arg expose av = .int[], n = .int
  return mkstr(capitalize(strof(av[1])))
  return 1

/* STRING-TRIM STRING-LEFT-TRIM STRING-RIGHT-TRIM */
pf171: procedure = .int
  arg expose av = .int[], n = .int
  chars = strof(av[1])
  s = strof(av[2])
  nm = cstr[curfn]
  if nm <> 'STRING-RIGHT-TRIM' then do
    do while length(s) > 0 & pos(left(s, 1), chars) > 0
      s = substr(s, 2)
    end
  end
  if nm <> 'STRING-LEFT-TRIM' then do
    do while length(s) > 0 & pos(right(s, 1), chars) > 0
      s = left(s, length(s) - 1)
    end
  end
  return mkstr(s)
  return 1

/* MAKE-STRING */
pf172: procedure = .int
  arg expose av = .int[], n = .int
  c = ' '
  j = kwidx(av, n, 2, 'INITIAL-ELEMENT')
  if j > 0 then c = d2c(cext[av[j]])
  return mkstr(copies(c, toint(av[1])))
  return 1

/* SEARCH */
pf173: procedure = .int
  arg expose av = .int[], n = .int
  a = av[1]
  b = av[2]
  if isstring(a) = 1 & isstring(b) = 1 then do
    p = pos(cstr[a], cstr[b])
    if length(cstr[a]) = 0 then return mkint(0)
    if p = 0 then return 1
    return mkint(p - 1)
  end
  x = .int[]
  y = .int[]
  k = seq2arr(a, x)
  m = seq2arr(b, y)
  do i = 1 to m - k + 1
    ok = 1
    do j = 1 to k
      if eql(x[j], y[i + j - 1]) = 0 then do
        ok = 0
        leave
      end
    end
    if ok = 1 then return mkint(i - 1)
  end
  return 1
  return 1

/* SYMBOL-NAME */
pf174: procedure = .int
  arg expose av = .int[], n = .int
  return mkstr(cstr[av[1]])
  return 1

/* INTERN */
pf175: procedure = .int
  arg expose av = .int[], n = .int
  return intern(cstr[av[1]])
  return 1

/* MAKE-SYMBOL */
pf176: procedure = .int
  arg expose av = .int[], n = .int
  c = newcell(2)
  cstr[c] = cstr[av[1]]
  ccar[c] = 0
  ccdr[c] = 0
  cspec[c] = 3
  return c
  return 1

/* GENSYM GENTEMP */
pf177: procedure = .int
  arg expose av = .int[], n = .int
  gensymn = gensymn + 1
  c = newcell(2)
  cstr[c] = 'G' || gensymn
  ccar[c] = 0
  ccdr[c] = 0
  cspec[c] = 3
  return c
  return 1

/* SYMBOL-VALUE */
pf178: procedure = .int
  arg expose av = .int[], n = .int
  v = ccar[av[1]]
  if v = 0 then return lerrk('UNBOUND-VARIABLE', 'the variable ' || cstr[av[1]] || ' is unbound')
  return v
  return 1

/* SYMBOL-FUNCTION FDEFINITION */
pf179: procedure = .int
  arg expose av = .int[], n = .int
  return fnof(av[1])
  return 1

/* SET */
pf180: procedure = .int
  arg expose av = .int[], n = .int
  ccar[av[1]] = av[2]
  return av[2]
  return 1

/* BOUNDP */
pf181: procedure = .int
  arg expose av = .int[], n = .int
  return truth(ccar[av[1]] <> 0)
  return 1

/* FBOUNDP */
pf182: procedure = .int
  arg expose av = .int[], n = .int
  f = ccdr[av[1]]
  return truth(f > 1)
  return 1

/* MAKUNBOUND */
pf183: procedure = .int
  arg expose av = .int[], n = .int
  ccar[av[1]] = 0
  return av[1]
  return 1

/* GET */
pf184: procedure = .int
  arg expose av = .int[], n = .int
  v = getprop(av[1], av[2])
  if v = 1 & n = 3 then return av[3]
  return v
  return 1

/* TYPEP */
pf185: procedure = .int
  arg expose av = .int[], n = .int
  return truth(typep(av[1], av[2]))
  return 1

/* TYPE-OF */
pf186: procedure = .int
  arg expose av = .int[], n = .int
  return lobjtype(av[1])
  return 1

/* MAKE-HASH-TABLE */
pf187: procedure = .int
  arg expose av = .int[], n = .int
  mode = '0'
  j = kwidx(av, n, 1, 'TEST')
  if j > 0 then do
    nm = cstr[av[j]]
    if nm = 'EQUAL' then mode = '1'
    else if nm = 'EQUALP' then mode = '2'
    else if nm = 'EQL' | nm = 'EQ' then mode = '0'
    else do
      if av[j] > 0 then do
        if ctag[av[j]] = 5 then do
          nm = cstr[av[j]]
          if nm = 'EQUAL' then mode = '1'
          if nm = 'EQUALP' then mode = '2'
        end
      end
    end
  end
  return mkhash(mode)
  return 1

/* GETHASH */
pf188: procedure = .int
  arg expose av = .int[], n = .int
  e = htfind(av[2], av[1])
  if e = 0 then do
    mvlist = list2(1, 1)
    if n = 3 then return av[3]
    return 1
  end
  mvlist = list2(htv[e], 2)
  return htv[e]
  return 1

/* REMHASH */
pf189: procedure = .int
  arg expose av = .int[], n = .int
  return truth(htrem(av[2], av[1]))
  return 1

/* CLRHASH */
pf190: procedure = .int
  arg expose av = .int[], n = .int
  call htclear av[1]
  return av[1]
  return 1

/* HASH-TABLE-COUNT */
pf191: procedure = .int
  arg expose av = .int[], n = .int
  return mkint(ccdr[av[1]])
  return 1

/* MAPHASH */
pf192: procedure = .int
  arg expose av = .int[], n = .int
  fn = fnof(av[1])
  if unw <> 0 then return 1
  ks = .int[]
  vs = .int[]
  e = ccar[av[2]]
  k = 0
  do while e <> 0
    k = k + 1
    ks[k] = htk[e]
    vs[k] = htv[e]
    e = hto[e]
  end
  do i = 1 to k
    junk = call2(fn, ks[i], vs[i])
    if unw <> 0 then return 1
  end
  return 1
  return 1

/* HASH-TABLE-KEYS */
pf193: procedure = .int
  arg expose av = .int[], n = .int
  r = 1
  e = ccar[av[1]]
  do while e <> 0
    r = cons(htk[e], r)
    e = hto[e]
  end
  return nreverse(r)
  return 1

/* HASH-TABLE-VALUES */
pf194: procedure = .int
  arg expose av = .int[], n = .int
  r = 1
  e = ccar[av[1]]
  do while e <> 0
    r = cons(htv[e], r)
    e = hto[e]
  end
  return nreverse(r)
  return 1

/* ERROR */
pf195: procedure = .int
  arg expose av = .int[], n = .int
  if isstring(av[1]) = 0 then do
    return lerror(printobj(av[1], 0))
  end
  return lerror(formatargs(av, 1, n))
  return 1

/* WARN */
pf196: procedure = .int
  arg expose av = .int[], n = .int
  call freshline
  call emit 'WARNING: ' || formatargs(av, 1, n) || '0a'x
  return 1
  return 1

/* %MKSTRUCT */
pf197: procedure = .int
  arg expose av = .int[], n = .int
  ty = ccar[curfn]
  slots = ccdr[ty]
  dfl = ccar[ty]
  cnt = listlen(slots)
  base = nvdat + 1
  nvdat = nvdat + cnt
  inst = newcell(11)
  ccar[inst] = ty
  cext[inst] = base
  ccdr[inst] = cnt
  i = 0
  do while iscons(slots) = 1
    j = kwidx(av, n, 1, cstr[ccar[slots]])
    if j > 0 then vdat[base + i] = av[j]
    else do
      vdat[base + i] = eval(ccar[dfl], 1)
      if unw <> 0 then return 1
    end
    i = i + 1
    slots = ccdr[slots]
    dfl = ccdr[dfl]
  end
  return inst
  return 1

/* %STRUCTP */
pf198: procedure = .int
  arg expose av = .int[], n = .int
  x = av[1]
  if x > 0 then do
    if ctag[x] = 11 then do
      if ccar[x] = ccar[curfn] then return 2
    end
  end
  return 1
  return 1

/* %STRUCTGET */
pf199: procedure = .int
  arg expose av = .int[], n = .int
  x = av[1]
  if x <= 0 then return lerrk('TYPE-ERROR', 'the value ' || printobj(x, 1) || ' is not a ' || cstr[ccdr[curfn]])
  if ctag[x] <> 11 then return lerrk('TYPE-ERROR', 'the value ' || printobj(x, 1) || ' is not a ' || cstr[ccdr[curfn]])
  return vdat[cext[x] + intval(ccar[curfn])]
  return 1

/* %COPYSTRUCT */
pf200: procedure = .int
  arg expose av = .int[], n = .int
  x = av[1]
  inst = newcell(11)
  ccar[inst] = ccar[x]
  ccdr[inst] = ccdr[x]
  cext[inst] = nvdat + 1
  do i = 0 to ccdr[x] - 1
    nvdat = nvdat + 1
    vdat[nvdat] = vdat[cext[x] + i]
  end
  return inst
  return 1

/* PRINT */
pf201: procedure = .int
  arg expose av = .int[], n = .int
  call emit '0a'x || printobj(av[1], 1) || ' '
  return av[1]
  return 1

/* PRIN1 */
pf202: procedure = .int
  arg expose av = .int[], n = .int
  call emit printobj(av[1], 1)
  return av[1]
  return 1

/* PRINC */
pf203: procedure = .int
  arg expose av = .int[], n = .int
  call emit printobj(av[1], 0)
  return av[1]
  return 1

/* WRITE */
pf204: procedure = .int
  arg expose av = .int[], n = .int
  call emit printobj(av[1], 1)
  return av[1]
  return 1

/* TERPRI */
pf205: procedure = .int
  arg expose av = .int[], n = .int
  call emit '0a'x
  return 1
  return 1

/* FRESH-LINE */
pf206: procedure = .int
  arg expose av = .int[], n = .int
  call freshline
  return 1
  return 1

/* WRITE-STRING WRITE-LINE */
pf207: procedure = .int
  arg expose av = .int[], n = .int
  call emit strof(av[1])
  if cstr[curfn] = 'WRITE-LINE' then call emit '0a'x
  return av[1]
  return 1

/* WRITE-CHAR */
pf208: procedure = .int
  arg expose av = .int[], n = .int
  call emit d2c(cext[av[1]])
  return av[1]
  return 1

/* FORMAT */
pf209: procedure = .int
  arg expose av = .int[], n = .int
  dest = av[1]
  if isstring(dest) = 1 then do
    s = formatargs(av, 1, n)
    if unw <> 0 then return 1
    call emit s
    return 1
  end
  s = formatargs(av, 2, n)
  if unw <> 0 then return 1
  if dest = 1 then return mkstr(s)
  call emit s
  return 1
  return 1

/* PRINC-TO-STRING */
pf210: procedure = .int
  arg expose av = .int[], n = .int
  return mkstr(printobj(av[1], 0))
  return 1

/* PRIN1-TO-STRING WRITE-TO-STRING */
pf211: procedure = .int
  arg expose av = .int[], n = .int
  return mkstr(printobj(av[1], 1))
  return 1

/* READ-LINE */
pf212: procedure = .int
  arg expose av = .int[], n = .int
  if lines() = 0 then do
    if n >= 3 then do
      if av[2] = 1 then return av[3]
    end
    if n >= 2 then do
      if av[2] <> 1 then return lerror('end of file on standard input')
    end
    return 1
  end
  return mkstr(linein())
  return 1

/* READ-FROM-STRING READ */
pf213: procedure = .int
  arg expose av = .int[], n = .int
  txt = ''
  if cstr[curfn] = 'READ' then do
    if lines() = 0 then return 1
    txt = linein()
  end
  else do
    txt = strof(av[1])
  end
  osrc = src
  orp = rp
  orl = rlen
  src = txt
  rp = 1
  rlen = length(txt)
  x = readobj()
  src = osrc
  rp = orp
  rlen = orl
  if x = 0 then return 1
  return x
  return 1

/* EVAL */
pf214: procedure = .int
  arg expose av = .int[], n = .int
  return eval(av[1], 1)
  return 1

/* LOAD */
pf215: procedure = .int
  arg expose av = .int[], n = .int
  rc = loadfile(strof(av[1]))
  if rc <> 0 then return 1
  return 2
  return 1

/* MACROEXPAND-1 MACROEXPAND */
pf216: procedure = .int
  arg expose av = .int[], n = .int
  x = av[1]
  do forever
    nx = macroexp1(x)
    if unw <> 0 then return 1
    if nx = 0 then return x
    x = nx
    if cstr[curfn] = 'MACROEXPAND-1' then return x
  end
  return x
  return 1

/* FINISH-OUTPUT FORCE-OUTPUT GC ROOM */
pf217: procedure = .int
  arg expose av = .int[], n = .int
  return 1
  return 1

/* GET-UNIVERSAL-TIME */
pf218: procedure = .int
  arg expose av = .int[], n = .int
  return mkint(time('S') as .int)
  return 1

/* GET-INTERNAL-REAL-TIME GET-INTERNAL-RUN-TIME */
pf219: procedure = .int
  arg expose av = .int[], n = .int
  return mkint(time('US') as .int / 1000)
  return 1

/* SLEEP */
pf220: procedure = .int
  arg expose av = .int[], n = .int
  return 1
  return 1

/* EXIT QUIT BYE */
pf221: procedure = .int
  arg expose av = .int[], n = .int
  call freshline
  rc = 0
  if n = 1 then do
    if av[1] < 0 then rc = intval(av[1])
  end
  exit rc
  return 1
  return 1

/* SYMBOL-PLIST */
pf222: procedure = .int
  arg expose av = .int[], n = .int
  if cpl[av[1]] = 0 then return 1
  return cpl[av[1]]
  return 1

/* PROVIDE REQUIRE */
pf223: procedure = .int
  arg expose av = .int[], n = .int
  return 1
  return 1

