pf62: procedure = .int
  arg expose av = .int[], n = .int
  fn = fnof(av[1])
  if unw <> 0 then return 1
  b = .int[]
  do i = 2 to n
    b[i - 1] = av[i]
  end
  return applyfn(fn, b, n - 1)
  return 1

/* APPLY */
pf63: procedure = .int
  arg expose av = .int[], n = .int
  fn = fnof(av[1])
  if unw <> 0 then return 1
  b = .int[]
  k = 0
  do i = 2 to n - 1
    k = k + 1
    b[k] = av[i]
  end
  if n >= 2 then do
    l = av[n]
    do while iscons(l) = 1
      k = k + 1
      b[k] = ccar[l]
      l = ccdr[l]
    end
  end
  return applyfn(fn, b, k)
  return 1

