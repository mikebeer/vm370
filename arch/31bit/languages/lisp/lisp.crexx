initprelude: procedure = .void
  p = ''
  p = p || ";;; Library code written in Lisp itself, loaded at start-up." || '0a'x
  p = p || "" || '0a'x
  p = p || "(defun endp (x) (null x))" || '0a'x
  p = p || "(defun complement (f) (lambda (&rest args) (not (apply f args))))" || '0a'x
  p = p || "(defun constantly (v) (lambda (&rest args) v))" || '0a'x
  p = p || "(defun revappend (a b) (append (reverse a) b))" || '0a'x
  p = p || "(defun nreconc (a b) (append (nreverse a) b))" || '0a'x
  p = p || "(defun copy-alist (al) (mapcar (lambda (p) (if (consp p) (cons (car p) (cdr p)) p)) al))" || '0a'x
  p = p || "(defun member-if (p l) (do ((x l (cdr x))) ((null x) nil) (when (funcall p (car x)) (return x))))" || '0a'x
  p = p || "(defun member-if-not (p l) (do ((x l (cdr x))) ((null x) nil) (unless (funcall p (car x)) (return x))))" || '0a'x
  p = p || "(defun assoc-if (p al) (dolist (e al nil) (when (and (consp e) (funcall p (car e))) (return e))))" || '0a'x
  p = p || "(defun find-if-not (p s) (find-if (complement p) s))" || '0a'x
  p = p || "(defun position-if-not (p s) (position-if (complement p) s))" || '0a'x
  p = p || "(defun count-if-not (p s) (count-if (complement p) s))" || '0a'x
  p = p || "(defun mapcon (f l) (apply #'nconc (maplist f l)))" || '0a'x
  p = p || "(defun sublis (al tree)" || '0a'x
  p = p || "  (cond ((atom tree) (let ((p (assoc tree al))) (if p (cdr p) tree)))" || '0a'x
  p = p || "        (t (cons (sublis al (car tree)) (sublis al (cdr tree))))))" || '0a'x
  p = p || "" || '0a'x
  p = p || ";;; ---- extended LOOP ----------------------------------------------------" || '0a'x
  p = p || "(defvar *lp-bind* nil)" || '0a'x
  p = p || "(defvar *lp-head* nil)" || '0a'x
  p = p || "(defvar *lp-body* nil)" || '0a'x
  p = p || "(defvar *lp-step* nil)" || '0a'x
  p = p || "(defvar *lp-init* nil)" || '0a'x
  p = p || "(defvar *lp-final* nil)" || '0a'x
  p = p || "(defvar *lp-result* nil)" || '0a'x
  p = p || "(defvar *lp-end* nil)" || '0a'x
  p = p || "(defvar *lp-lacc* nil)" || '0a'x
  p = p || "(defvar *lp-sum* nil)" || '0a'x
  p = p || "(defvar *lp-cnt* nil)" || '0a'x
  p = p || "(defvar *lp-max* nil)" || '0a'x
  p = p || "(defvar *lp-min* nil)" || '0a'x
  p = p || "" || '0a'x
  p = p || "(defun %lp-word (x) (if (and x (symbolp x)) (symbol-name x) """"))" || '0a'x
  p = p || "(defun %lp-is (x &rest names) (member (%lp-word x) names :test #'string=))" || '0a'x
  p = p || "(defun %lp-bind (var init) (push (list var init) *lp-bind*))" || '0a'x
  p = p || "(defun %lp-head (form) (push form *lp-head*))" || '0a'x
  p = p || "(defun %lp-step (form) (push form *lp-step*))" || '0a'x
  p = p || "" || '0a'x
  p = p || "(defun %lp-vars (pat)" || '0a'x
  p = p || "  (cond ((null pat) nil)" || '0a'x
  p = p || "        ((symbolp pat) (list pat))" || '0a'x
  p = p || "        (t (append (%lp-vars (car pat)) (%lp-vars (cdr pat))))))" || '0a'x
  p = p || "" || '0a'x
  p = p || "(defun %lp-destr (pat expr)" || '0a'x
  p = p || "  (cond ((null pat) nil)" || '0a'x
  p = p || "        ((symbolp pat) (list (list 'setq pat expr)))" || '0a'x
  p = p || "        (t (append (%lp-destr (car pat) (list 'car expr))" || '0a'x
  p = p || "                   (%lp-destr (cdr pat) (list 'cdr expr))))))" || '0a'x
  p = p || "" || '0a'x
  p = p || ";; assign the pattern PAT from EXPR each iteration" || '0a'x
  p = p || "(defun %lp-assign (pat expr)" || '0a'x
  p = p || "  (if (symbolp pat)" || '0a'x
  p = p || "      (%lp-head (list 'setq pat expr))" || '0a'x
  p = p || "      (let ((e (gensym)))" || '0a'x
  p = p || "        (%lp-bind e nil)" || '0a'x
  p = p || "        (%lp-head (list 'setq e expr))" || '0a'x
  p = p || "        (dolist (f (%lp-destr pat e)) (%lp-head f)))))" || '0a'x
  p = p || "" || '0a'x
  p = p || "(defun %lp-bindvars (pat)" || '0a'x
  p = p || "  (dolist (v (%lp-vars pat)) (%lp-bind v nil)))" || '0a'x
  p = p || "" || '0a'x
  p = p || "(defun %lp-for (cl)" || '0a'x
  p = p || "  (let* ((var (cadr cl)) (rest (cddr cl)) (w (car rest)))" || '0a'x
  p = p || "    (cond" || '0a'x
  p = p || "      ((%lp-is w ""IN"")" || '0a'x
  p = p || "       (let ((l (gensym)) (by nil))" || '0a'x
  p = p || "         (%lp-bind l (cadr rest))" || '0a'x
  p = p || "         (%lp-bindvars var)" || '0a'x
  p = p || "         (setq rest (cddr rest))" || '0a'x
  p = p || "         (when (%lp-is (car rest) ""BY"") (setq by (cadr rest)) (setq rest (cddr rest)))" || '0a'x
  p = p || "         (%lp-head (list 'when (list 'atom l) *lp-end*))" || '0a'x
  p = p || "         (%lp-assign var (list 'car l))" || '0a'x
  p = p || "         (%lp-step (list 'setq l (if by (list 'funcall by l) (list 'cdr l))))" || '0a'x
  p = p || "         rest))" || '0a'x
  p = p || "      ((%lp-is w ""ON"")" || '0a'x
  p = p || "       (let ((l (gensym)) (by nil))" || '0a'x
  p = p || "         (%lp-bind l (cadr rest))" || '0a'x
  p = p || "         (%lp-bindvars var)" || '0a'x
  p = p || "         (setq rest (cddr rest))" || '0a'x
  p = p || "         (when (%lp-is (car rest) ""BY"") (setq by (cadr rest)) (setq rest (cddr rest)))" || '0a'x
  p = p || "         (%lp-head (list 'when (list 'atom l) *lp-end*))" || '0a'x
  p = p || "         (%lp-assign var l)" || '0a'x
