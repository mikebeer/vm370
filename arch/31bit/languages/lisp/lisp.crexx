  return nreverse(r)
  return 1

/* MAP */
pf85: procedure = .int
  arg expose av = .int[], n = .int
  fn = fnof(av[2])
  if unw <> 0 then return 1
  nl = n - 2
  sq = .int[]
  cnt = 0
  ls = .int[]
  mn = 999999999
  do i = 1 to nl
    a = .int[]
    k = seq2arr(av[i + 2], a)
    if k < mn then mn = k
    do j = 1 to k
      sq[(i - 1) * 100000 + j] = a[j]
    end
  end
  r = .int[]
  b = .int[]
  do j = 1 to mn
    do i = 1 to nl
      b[i] = sq[(i - 1) * 100000 + j]
    end
    v = applyfn(fn, b, nl)
    if unw <> 0 then return 1
    r[j] = v
  end
  ty = av[1]
  if ty = 1 then return 1
  nm = cstr[ty]
  if nm = 'LIST' then return arr2list(r, 1, mn)
  if nm = 'STRING' then return arr2seq(mkstr(''), r, mn)
  return mkvec(r, mn)
  return 1

/* REDUCE */
pf86: procedure = .int
  arg expose av = .int[], n = .int
  fn = fnof(av[1])
  if unw <> 0 then return 1
  kf = kwfn(av, n, 3, 'KEY')
  a = .int[]
  k = seq2arr(av[2], a)
  fe = 0
  j = kwidx(av, n, 3, 'FROM-END')
  if j > 0 then do
    if av[j] <> 1 then fe = 1
  end
  j = kwidx(av, n, 3, 'INITIAL-VALUE')
  hasinit = 0
  if j > 0 then hasinit = 1
  if fe = 0 then do
    st = 1
    if hasinit = 1 then acc = av[j]
    else do
      if k = 0 then return applyfn(fn, a, 0)
      acc = keyed(kf, a[1])
      st = 2
    end
    do i = st to k
      acc = call2(fn, acc, keyed(kf, a[i]))
      if unw <> 0 then return 1
    end
    return acc
  end
  st = k
  if hasinit = 1 then acc = av[j]
  else do
    if k = 0 then return applyfn(fn, a, 0)
    acc = keyed(kf, a[k])
    st = k - 1
  end
  do i = st to 1 by -1
    acc = call2(fn, keyed(kf, a[i]), acc)
    if unw <> 0 then return 1
  end
  return acc
  return 1

