/* REMOVE-DUPLICATES DELETE-DUPLICATES */
pf90: procedure = .int
  arg expose av = .int[], n = .int
  tf = kwfn(av, n, 2, 'TEST')
  kf = kwfn(av, n, 2, 'KEY')
  a = .int[]
  k = seq2arr(av[1], a)
  b = .int[]
  m = 0
  do i = 1 to k
    dup = 0
    do j = i + 1 to k
      if same(tf, keyed(kf, a[i]), keyed(kf, a[j])) = 1 then do
        dup = 1
        leave
      end
    end
    if dup = 0 then do
      m = m + 1
      b[m] = a[i]
    end
  end
  return arr2seq(av[1], b, m)
  return 1

