/*
 * lisp.crexx - a Common Lisp interpreter written in CREXX Level B
 *
 * Usage:   rxvm lisp.rxbin -a [file.lisp ...]
 *
 *   With one or more files, each is loaded and run. Without arguments an
 *   interactive read-eval-print loop reads from standard input.
 *
 * Data model: every Lisp object is an integer "reference".
 *   reference < 0   a fixnum:  n >= 0 is -(2n+1), n < 0 is 2n
 *   reference > 0   a cell in the heap arrays ctag ccar ccdr cext cnum cstr
 *   reference 1     NIL        reference 2   T        reference 0  "none"
 * Cell tags: 1 cons, 2 symbol, 3 float, 4 string, 5 primitive, 6 closure,
 *   7 macro, 8 character, 9 vector, 10 hash table, 11 structure type.
 */
options levelb
namespace lisp expose ctag ccar ccdr cext cnum cstr chn ncell hbk vdat nvdat htk htv htn nhte htb nht gensymn unw unwtag unwval errmsg outcol hasfenv ndepth maxdepth loadmode nprim primname sNIL sT sQUOTE sFUNCTION sQUASI sUNQ sUNQS sLAMBDA sOPT sREST sKEY sELSE sERROR sTHEN src rp rlen cspec cfk cpl cslot pmin pmax hto hpv mvlist curfn errkind capdepth capbuf eofflag fidx fstop sOTHERWISE sBLOCK sLAMBDALIST seed catchtags fsemi sRETFROM sRETURN sAUX sXLOOP sBODY

import rxfnsb

arg argv = .string[]

/* ------------------------------------------------------------------ heap */
ctag = .int[]        /* cell type                                           */
ccar = .int[]        /* car / symbol value / closure parameters             */
ccdr = .int[]        /* cdr / symbol function / closure body                */
cext = .int[]        /* special-form id, primitive id, closure environment  */
cnum = .float[]      /* float value                                         */
cstr = .string[]     /* string value / symbol name                          */
chn = .int[]         /* symbol hash chain                                   */
ncell = 0
hbk = .int[]         /* symbol hash buckets                                 */
vdat = .int[]        /* vector storage                                      */
nvdat = 0
htk = .int[]         /* hash table entry: key                               */
htv = .int[]         /* hash table entry: value                             */
htn = .int[]         /* hash table entry: next in chain                     */
nhte = 0
htb = .int[]         /* hash table buckets (table id * 256 + hash)          */
nht = 0
gensymn = 0

unw = 0              /* non-local exit: 0 none, 1 error, 2 throw, 3 return-from */
unwtag = 1
unwval = 1
errmsg = ''
outcol = 0           /* output column, for fresh-line */
hasfenv = 0          /* 1 once flet/labels has been used */
ndepth = 0           /* evaluation depth */
maxdepth = 0
loadmode = 0
nprim = 0
primname = .string[]

/* well known symbols, set by initlisp */
sNIL = 1
sT = 2
sQUOTE = 0
sFUNCTION = 0
sQUASI = 0
sUNQ = 0
sUNQS = 0
sLAMBDA = 0
sOPT = 0
sREST = 0
sKEY = 0
sELSE = 0
sERROR = 0
sTHEN = 0

src = ''             /* text being read */
rp = 1               /* read position */
rlen = 0


cspec = .int[]       /* symbol flag: 1 special variable, 2 constant */
cfk = .int[]         /* cached local-function key symbol */
cpl = .int[]         /* symbol property list */
cslot = .int[]       /* structure accessor: slot index + 1 */
pmin = .int[]        /* primitive minimum argument count */
pmax = .int[]        /* primitive maximum argument count, -1 for any */
hto = .int[]         /* hash table entry: next in insertion order */
hpv = .int[]         /* hash table entry: previous in insertion order */
mvlist = 0           /* list of multiple values from the latest VALUES */
curfn = 0            /* the primitive being called */
errkind = 'ERROR'
capdepth = 0         /* with-output-to-string nesting */
capbuf = ''
eofflag = 0          /* the reader ran out of input inside a list */
fidx = 0             /* FORMAT argument index */
fstop = 0            /* FORMAT ~^ seen */
sOTHERWISE = 0
sBLOCK = 0
sLAMBDALIST = 0
seed = 12345
catchtags = 1       /* tags of the active CATCH forms */

fsemi = ''           /* positions of ~; found by fmtfind */
sRETFROM = 0
sRETURN = 0
sAUX = 0
sXLOOP = 0
sBODY = 0

/* ---------------------------------------------------------------- driver */
call initlisp
call initprims
call initprelude
if argv.0 >= 1 then do
  rc = 0
  do ai = 1 to argv.0
    rc = loadfile(argv[ai])
    if rc <> 0 then leave
  end
  call freshline
  exit rc
end
call repl
exit 0


newcell: procedure = .int
  arg tag = .int
  ncell = ncell + 1
  ctag[ncell] = tag
  ccar[ncell] = 1
  ccdr[ncell] = 1
  cext[ncell] = 0
  return ncell

mkint: procedure = .int
  arg n = .int
  if n >= 0 then return 0 - (2 * n + 1)
  return 2 * n

isint: procedure = .int
  arg r = .int
  if r < 0 then return 1
  return 0

intval: procedure = .int
  arg r = .int
  if r % 2 = 0 then return r / 2
  return (0 - r - 1) / 2

mkfloat: procedure = .int
  arg x = .float
  c = newcell(3)
  cnum[c] = x
  return c

mkstr: procedure = .int
  arg s = .string
  c = newcell(4)
  cstr[c] = s
  return c

mkchar: procedure = .int
  arg code = .int
  c = newcell(8)
  cext[c] = code
  return c

cons: procedure = .int
  arg a = .int, d = .int
  c = newcell(1)
  ccar[c] = a
  ccdr[c] = d
  return c

list1: procedure = .int
  arg a = .int
  return cons(a, 1)

list2: procedure = .int
  arg a = .int, b = .int
  return cons(a, cons(b, 1))

list3: procedure = .int
  arg a = .int, b = .int, c = .int
  return cons(a, cons(b, cons(c, 1)))

iscons: procedure = .int
  arg r = .int
  if r > 0 then do
    if ctag[r] = 1 then return 1
  end
  return 0

issym: procedure = .int
  arg r = .int
  if r > 0 then do
    if ctag[r] = 2 then return 1
  end
  return 0

isstring: procedure = .int
  arg r = .int
  if r > 0 then do
    if ctag[r] = 4 then return 1
  end
  return 0

isfloat: procedure = .int
  arg r = .int
  if r > 0 then do
    if ctag[r] = 3 then return 1
  end
  return 0

ischar: procedure = .int
  arg r = .int
  if r > 0 then do
    if ctag[r] = 8 then return 1
  end
  return 0

isnum: procedure = .int
  arg r = .int
  if r < 0 then return 1
  if r > 0 then do
    if ctag[r] = 3 then return 1
  end
  return 0

truth: procedure = .int
  arg b = .int
  if b <> 0 then return 2
  return 1

/* ---------------------------------------------------------------- errors */
lerror: procedure = .int
  arg msg = .string
  if unw = 0 then do
    unw = 1
    errmsg = msg
    errkind = 'ERROR'
  end
  return 1

/* the safe versions of car and cdr */
car: procedure = .int
  arg r = .int
  if r = 1 then return 1
  if iscons(r) = 1 then return ccar[r]
  junk = lerrk('TYPE-ERROR', 'the value ' || printobj(r, 1) || ' is not a list')
  return 1

cdr: procedure = .int
  arg r = .int
  if r = 1 then return 1
  if iscons(r) = 1 then return ccdr[r]
  junk = lerrk('TYPE-ERROR', 'the value ' || printobj(r, 1) || ' is not a list')
  return 1

/* ------------------------------------------------------------ list helpers */
listlen: procedure = .int
  arg l = .int
  n = 0
  do while iscons(l) = 1
    n = n + 1
    l = ccdr[l]
  end
  return n

/* build a Lisp list from av[from..n] */
arr2list: procedure = .int
  arg expose av = .int[], from = .int, n = .int
  l = 1
  do i = n to from by -1
    l = cons(av[i], l)
  end
  return l

list2arr: procedure = .int
  arg l = .int, expose av = .int[]
  n = 0
  do while iscons(l) = 1
    n = n + 1
    av[n] = ccar[l]
    l = ccdr[l]
  end
  return n

reverse: procedure = .int
  arg l = .int
  r = 1
  do while iscons(l) = 1
    r = cons(ccar[l], r)
    l = ccdr[l]
  end
  return r

/* destructively reverse (fresh conses only) */
nreverse: procedure = .int
  arg l = .int
  prev = 1
  do while iscons(l) = 1
    nx = ccdr[l]
    ccdr[l] = prev
    prev = l
    l = nx
  end
  return prev

append2: procedure = .int
  arg a = .int, b = .int
  if iscons(a) = 0 then return b
  r = 1
  do while iscons(a) = 1
    r = cons(ccar[a], r)
    a = ccdr[a]
  end
  do while iscons(r) = 1
    nx = ccdr[r]
    ccdr[r] = b
    b = r
    r = nx
  end
  return b

/* ------------------------------------------------------------- symbols */
hashname: procedure = .int
  arg s = .string
  h = 7
  do i = 1 to length(s)
    h = (h * 31 + c2d(substr(s, i, 1))) % 8191
  end
  return h

intern: procedure = .int
  arg name = .string
  h = hashname(name)
  c = hbk[h]
  do while c <> 0
    if cstr[c] == name then return c
    c = chn[c]
  end
  c = newcell(2)
  cstr[c] = name
  ccar[c] = 0
  ccdr[c] = 0
  chn[c] = hbk[h]
  hbk[h] = c
  if left(name, 1) = ':' then do
    ccar[c] = c
    cspec[c] = 2
  end
  return c

mksym: procedure = .int
  arg name = .string
  return intern(upper(name))

symname: procedure = .string
  arg r = .int
  return cstr[r]

/* ------------------------------------------------------------- numbers */
/* numeric value of a number reference as a float */
fval: procedure = .float
  arg r = .int
  if r < 0 then do
    n = intval(r)
    f = n * 1.0
    return f
  end
  return cnum[r]

/* text of a float: always shows a decimal point or an exponent */
floattext: procedure = .string
  arg x = .float
  ax = x
  sg = ''
  if x < 0.0 then do
    ax = 0.0 - x
    sg = '-'
  end
  if ax >= 10000000.0 | (ax < 0.001 & ax > 0.0) then do
    m = ax
    ex = 0
    do while m >= 10.0
      m = m / 10.0
      ex = ex + 1
    end
    do while m < 1.0
      m = m * 10.0
      ex = ex - 1
    end
    ms = m || ''
    if pos('.', ms) = 0 then ms = ms || '.0'
    return sg || ms || 'e' || ex
  end
  s = x || ''
  if pos('.', s) = 0 & pos('e', s) = 0 & pos('E', s) = 0 then s = s || '.0'
  if left(s, 1) = '.' then s = '0' || s
  if left(s, 2) = '-.' then s = '-0' || substr(s, 2)
  return s

/* --------------------------------------------------------------- printer */
charname: procedure = .string
  arg code = .int
  if code = 32 then return 'Space'
  if code = 10 then return 'Newline'
  if code = 9 then return 'Tab'
  if code = 13 then return 'Return'
  return d2c(code)

printstring: procedure = .string
  arg s = .string
  o = '"'
  do i = 1 to length(s)
    c = substr(s, i, 1)
    if c = '"' then o = o || '\"'
    else if c = '\' then o = o || '\\'
    else o = o || c
  end
  return o || '"'

printobj: procedure = .string
  arg r = .int, esc = .int
  if r < 0 then return intval(r) || ''
  if r = 0 then return '#<none>'
  t = ctag[r]
  if t = 2 then do
    if cspec[r] = 3 & esc = 1 then return '#:' || cstr[r]
    return cstr[r]
  end
  if t = 3 then return floattext(cnum[r])
  if t = 4 then do
    if esc = 1 then return printstring(cstr[r])
    return cstr[r]
  end
  if t = 8 then do
    if esc = 1 then return '#\' || charname(cext[r])
    return d2c(cext[r])
  end
  if t = 1 then do
    h = ccar[r]
    if h = sQUOTE & iscons(ccdr[r]) = 1 & ccdr[ccdr[r]] = 1 then return "'" || printobj(ccar[ccdr[r]], esc)
    if h = sFUNCTION & iscons(ccdr[r]) = 1 & ccdr[ccdr[r]] = 1 then return "#'" || printobj(ccar[ccdr[r]], esc)
    s = '('
    first = 1
    n = 0
    do while iscons(r) = 1
      if first = 0 then s = s || ' '
      first = 0
      s = s || printobj(ccar[r], esc)
      r = ccdr[r]
      n = n + 1
      if n > 100000 then do
        s = s || ' ...'
        r = 1
      end
    end
    if r <> 1 then s = s || ' . ' || printobj(r, esc)
    return s || ')'
  end
  if t = 5 then return '#<FUNCTION ' || cstr[r] || '>'
  if t = 6 then return '#<FUNCTION (LAMBDA ' || printobj(ccar[r], 1) || ')>'
  if t = 7 then return '#<MACRO>'
  if t = 9 then do
    s = '#('
    n = ccdr[r]
    do i = 1 to n
      if i > 1 then s = s || ' '
      s = s || printobj(vdat[cext[r] + i - 1], esc)
    end
    return s || ')'
  end
  if t = 10 then return '#<HASH-TABLE>'
  if t = 11 then do
    s = '#S(' || cstr[ccar[r]]
    fl = ccdr[ccar[r]]
    i = 0
    do while iscons(fl) = 1
      s = s || ' :' || printobj(ccar[fl], 1) || ' ' || printobj(vdat[cext[r] + i], esc)
      i = i + 1
      fl = ccdr[fl]
    end
    return s || ')'
  end
  return '#<OBJECT>'

/* ---------------------------------------------------------------- reader */
isdelim: procedure = .int
  arg c = .string
  if c = '' then return 1
  if pos(c, ' ()' || "'" || '"' || ';' || '`' || ',' || '0a'x || '09'x || '0d'x) > 0 then return 1
  return 0

skipws: procedure = .void
  do forever
    if rp > rlen then return
    c = substr(src, rp, 1)
    if c = ' ' | c = '0a'x | c = '09'x | c = '0d'x then do
      rp = rp + 1
    end
    else if c = ';' then do
      do while rp <= rlen & substr(src, rp, 1) <> '0a'x
        rp = rp + 1
      end
    end
    else if c = '#' & substr(src, rp + 1, 1) = '|' then do
      d = 1
      rp = rp + 2
      do while rp <= rlen & d > 0
        if substr(src, rp, 2) = '|#' then do
          d = d - 1
          rp = rp + 2
        end
        else if substr(src, rp, 2) = '#|' then do
          d = d + 1
          rp = rp + 2
        end
        else rp = rp + 1
      end
    end
    else return
  end
  return

isnumtext: procedure = .int
  arg t = .string
  c = left(t, 1)
  if pos(c, '0123456789+-.') = 0 then return 0
  if t = '+' | t = '-' | t = '.' then return 0
  if datatype(t, 'N') = '1' then return 1
  return 0

parseatom: procedure = .int
  arg t = .string
  if isnumtext(t) = 1 then do
    if datatype(t, 'W') = '1' & pos('.', t) = 0 & pos('E', upper(t)) = 0 & length(t) < 18 then do
      n = t as .int
      return mkint(n)
    end
    x = t as .float
    return mkfloat(x)
  end
  return intern(upper(t))

/* read one object; returns 0 at end of input */
readobj: procedure = .int
  call skipws
  if rp > rlen then return 0
  c = substr(src, rp, 1)
  if c = '(' then do
    rp = rp + 1
    return readlist()
  end
  if c = ')' then do
    rp = rp + 1
    junk = lerror('unmatched close parenthesis')
    return 1
  end
  if c = "'" then do
    rp = rp + 1
    x = readobj()
    if x = 0 then do
      eofflag = 1
      return lerror('end of input after quote')
    end
    return list2(sQUOTE, x)
  end
  if c = '`' then do
    rp = rp + 1
    x = readobj()
    return list2(sQUASI, x)
  end
  if c = ',' then do
    rp = rp + 1
    if substr(src, rp, 1) = '@' then do
      rp = rp + 1
      x = readobj()
      return list2(sUNQS, x)
    end
    x = readobj()
    return list2(sUNQ, x)
  end
  if c = '"' then do
    rp = rp + 1
    s = ''
    do while rp <= rlen & substr(src, rp, 1) <> '"'
      d = substr(src, rp, 1)
      if d = '\' then do
        rp = rp + 1
        d = substr(src, rp, 1)
        if d = 'n' then d = '0a'x
        else if d = 't' then d = '09'x
      end
      s = s || d
      rp = rp + 1
    end
    rp = rp + 1
    return mkstr(s)
  end
  if c = '#' then do
    d = substr(src, rp + 1, 1)
    if d = "'" then do
      rp = rp + 2
      x = readobj()
      return list2(sFUNCTION, x)
    end
    if d = '\' then do
      rp = rp + 2
      ch = substr(src, rp, 1)
      rp = rp + 1
      nm = ch
      do while rp <= rlen & isdelim(substr(src, rp, 1)) = 0
        nm = nm || substr(src, rp, 1)
        rp = rp + 1
      end
      if length(nm) = 1 then return mkchar(c2d(nm))
      u = upper(nm)
      if u = 'SPACE' then return mkchar(32)
      if u = 'NEWLINE' | u = 'LINEFEED' then return mkchar(10)
      if u = 'TAB' then return mkchar(9)
      if u = 'RETURN' then return mkchar(13)
      return mkchar(c2d(left(nm, 1)))
    end
    if d = '(' then do
      rp = rp + 2
      l = readlist()
      return makevector(l)
    end
    if pos(d, 'xXbBoO') > 0 & d <> '' then do
      rp = rp + 2
      tk = ''
      do while rp <= rlen & isdelim(substr(src, rp, 1)) = 0
        tk = tk || substr(src, rp, 1)
        rp = rp + 1
      end
      base = 16
      if upper(d) = 'B' then base = 2
      if upper(d) = 'O' then base = 8
      return mkint(parsebase(tk, base))
    end
  end
  /* a symbol or a number */
  t = ''
  if c = '|' then do
    rp = rp + 1
    do while rp <= rlen & substr(src, rp, 1) <> '|'
      t = t || substr(src, rp, 1)
      rp = rp + 1
    end
    rp = rp + 1
    return intern(t)
  end
  do while rp <= rlen & isdelim(substr(src, rp, 1)) = 0
    t = t || substr(src, rp, 1)
    rp = rp + 1
  end
  return parseatom(t)

readlist: procedure = .int
  head = 1
  tail = 1
  do forever
    call skipws
    if rp > rlen then do
      eofflag = 1
      return lerror('end of input inside a list')
    end
    c = substr(src, rp, 1)
    if c = ')' then do
      rp = rp + 1
      return head
    end
    if c = '.' & isdelim(substr(src, rp + 1, 1)) = 1 & tail <> 1 then do
      rp = rp + 1
      x = readobj()
      ccdr[tail] = x
      call skipws
      if substr(src, rp, 1) = ')' then rp = rp + 1
      return head
    end
    x = readobj()
    if unw <> 0 then return 1
    cell = cons(x, 1)
    if head = 1 then head = cell
    else ccdr[tail] = cell
    tail = cell
  end
  return head

makevector: procedure = .int
  arg l = .int
  n = listlen(l)
  v = newcell(9)
  cext[v] = nvdat + 1
  ccdr[v] = n
  do while iscons(l) = 1
    nvdat = nvdat + 1
    vdat[nvdat] = ccar[l]
    l = ccdr[l]
  end
  return v


parsebase: procedure = .int
  arg tk = .string, base = .int
  neg = 0
  if left(tk, 1) = '-' then do
    neg = 1
    tk = substr(tk, 2)
  end
  v = 0
  do i = 1 to length(tk)
    d = pos(upper(substr(tk, i, 1)), '0123456789ABCDEF') - 1
    if d < 0 | d >= base then do
      junk = lerror('bad digit in number')
      return 0
    end
    v = v * base + d
  end
  if neg = 1 then v = 0 - v
  return v


/* ===================================================================== */
/*                               EVALUATOR                               */
/* ===================================================================== */
emit: procedure = .void
  arg s = .string
  if length(s) = 0 then return
  if capdepth > 0 then do
    capbuf = capbuf || s
    return
  end
  call charout 'stdout', s
  if right(s, 1) = '0a'x then outcol = 0
  else outcol = 1
  return

freshline: procedure = .void
  if capdepth > 0 then do
    if length(capbuf) > 0 & right(capbuf, 1) <> '0a'x then capbuf = capbuf || '0a'x
    return
  end
  if outcol <> 0 then call emit '0a'x
  return

reporterr: procedure = .void
  call freshline
  if unw = 1 then call emit 'Error: ' || errmsg || '0a'x
  else if unw = 2 then call emit 'Error: attempt to throw to a tag that does not exist: ' || printobj(unwtag, 1) || '0a'x
  else if unw = 3 then call emit 'Error: return from unknown block ' || printobj(unwtag, 1) || '0a'x
  unw = 0
  capdepth = 0
  capbuf = ''
  ndepth = 0
  return

/* ----------------------------------------------------------- variables */
fkey: procedure = .int
  arg f = .int
  if cfk[f] = 0 then cfk[f] = intern('#F:' || cstr[f])
  return cfk[f]

symval: procedure = .int
  arg s = .int, env = .int
  if cspec[s] = 2 then return ccar[s]
  e = env
  do while e <> 1
    b = ccar[e]
    if ccar[b] = s then return ccdr[b]
    e = ccdr[e]
  end
  v = ccar[s]
  if v = 0 then return lerrk('UNBOUND-VARIABLE', 'the variable ' || cstr[s] || ' is unbound')
  return v

setvar: procedure = .int
  arg s = .int, v = .int, env = .int
  if cspec[s] = 2 then return lerror('cannot assign to the constant ' || cstr[s])
  e = env
  do while e <> 1
    b = ccar[e]
    if ccar[b] = s then do
      ccdr[b] = v
      return v
    end
    e = ccdr[e]
  end
  ccar[s] = v
  return v

getfn: procedure = .int
  arg f = .int, env = .int
  if hasfenv = 1 then do
    k = fkey(f)
    e = env
    do while e <> 1
      b = ccar[e]
      if ccar[b] = k then return ccdr[b]
      e = ccdr[e]
    end
  end
  fn = ccdr[f]
  if fn = 0 | fn = 1 then return lerrk('UNDEFINED-FUNCTION', 'undefined function ' || cstr[f])
  return fn

/* resolve a function designator */
fnof: procedure = .int
  arg x = .int
  if x < 0 then return lerrk('TYPE-ERROR', 'the value ' || printobj(x, 1) || ' is not a function')
  if ctag[x] = 2 then do
    fn = ccdr[x]
    if fn = 0 | fn = 1 then return lerrk('UNDEFINED-FUNCTION', 'undefined function ' || cstr[x])
    return fn
  end
  if ctag[x] = 5 | ctag[x] = 6 then return x
  return lerrk('TYPE-ERROR', 'the value ' || printobj(x, 1) || ' is not a function')

mkclosure: procedure = .int
  arg params = .int, body = .int, env = .int
  c = newcell(6)
  ccar[c] = params
  ccdr[c] = body
  cext[c] = env
  cstr[c] = ''
  return c

/* does a tree mention the symbol RETURN-FROM or RETURN ? */
hasreturn: procedure = .int
  arg x = .int
  do while iscons(x) = 1
    a = ccar[x]
    if a = sRETFROM | a = sRETURN then return 1
    if iscons(a) = 1 then do
      if hasreturn(a) = 1 then return 1
    end
    x = ccdr[x]
  end
  return 0

/* does a tree mention LAMBDA or FUNCTION ? (a closure may capture a loop variable) */
hasclosure: procedure = .int
  arg x = .int
  do while iscons(x) = 1
    a = ccar[x]
    if a = sLAMBDA | a = sFUNCTION then return 1
    if iscons(a) = 1 then do
      if hasclosure(a) = 1 then return 1
    end
    x = ccdr[x]
  end
  return 0

/* ------------------------------------------------- parameter binding */
bindparams: procedure = .int
  arg params = .int, expose av = .int[], n = .int, cenv = .int
  env = cenv
  i = 1
  mode = 0
  kstart = 0
  p = params
  do while iscons(p) = 1
    s = ccar[p]
    p = ccdr[p]
    if s = sOPT then mode = 1
    else if s = sREST | s = sBODY then mode = 2
    else if s = sKEY then do
      mode = 3
      kstart = i
    end
    else if s = sAUX then mode = 4
    else if mode = 0 then do
      if i > n then return lerror('too few arguments')
      env = cons(cons(s, av[i]), env)
      i = i + 1
    end
    else if mode = 1 then do
      dflt = 1
      sv = 0
      if iscons(s) = 1 then do
        dflt = car(cdr(s))
        sv = car(cdr(cdr(s)))
        s = ccar[s]
      end
      if i <= n then do
        env = cons(cons(s, av[i]), env)
        if sv > 1 then env = cons(cons(sv, 2), env)
        i = i + 1
      end
      else do
        v = 1
        if dflt <> 1 then v = eval(dflt, env)
        if unw <> 0 then return 1
        env = cons(cons(s, v), env)
        if sv > 1 then env = cons(cons(sv, 1), env)
      end
    end
    else if mode = 2 then do
      if i <= n then env = cons(cons(s, arr2list(av, i, n)), env)
      else env = cons(cons(s, 1), env)
      i = n + 1
    end
    else if mode = 3 then do
      dflt = 1
      if iscons(s) = 1 then do
        dflt = car(cdr(s))
        s = ccar[s]
      end
      kw = intern(':' || cstr[s])
      found = 0
      j = kstart
      do while j < n & found = 0
        if av[j] = kw then found = j + 1
        j = j + 2
      end
      if found > 0 then env = cons(cons(s, av[found]), env)
      else do
        v = 1
        if dflt <> 1 then v = eval(dflt, env)
        if unw <> 0 then return 1
        env = cons(cons(s, v), env)
      end
      i = n + 1
    end
    else do
      /* &aux */
      dflt = 1
      if iscons(s) = 1 then do
        dflt = car(cdr(s))
        s = ccar[s]
      end
      v = 1
      if dflt <> 1 then v = eval(dflt, env)
      if unw <> 0 then return 1
      env = cons(cons(s, v), env)
    end
  end
  if i <= n & mode < 2 then return lerror('too many arguments')
  return env

/* evaluate all but the last form of a body; return the last form, 0 if none */
evalprefix: procedure = .int
  arg body = .int, env = .int
  if body = 1 then return 0
  do while ccdr[body] <> 1
    junk = eval(ccar[body], env)
    if unw <> 0 then return 0
    body = ccdr[body]
  end
  return ccar[body]

evalbody: procedure = .int
  arg body = .int, env = .int
  x = evalprefix(body, env)
  if x = 0 then return 1
  return eval(x, env)

/* evaluate an argument list into av; returns the count */
evalargs: procedure = .int
  arg l = .int, env = .int, expose av = .int[]
  n = 0
  do while l > 1
    n = n + 1
    f = ccar[l]
    if f < 0 then av[n] = f
    else if ctag[f] = 2 then av[n] = symval(f, env)
    else if ctag[f] = 1 then av[n] = eval(f, env)
    else av[n] = f
    if unw <> 0 then return n
    l = ccdr[l]
  end
  return n

/* ---------------------------------------------------- function calling */
applyfn: procedure = .int
  arg fn = .int, expose av = .int[], n = .int
  if fn < 0 then return lerror('the value ' || printobj(fn, 1) || ' is not a function')
  t = ctag[fn]
  if t = 5 then do
    curfn = fn
    id = cext[fn]
    if n < pmin[id] then return lerror('too few arguments to ' || cstr[fn])
    if pmax[id] >= 0 & n > pmax[id] then return lerror('too many arguments to ' || cstr[fn])
    return callprim(id, av, n)
  end
  if t = 6 then do
    env = bindparams(ccar[fn], av, n, cext[fn])
    if unw <> 0 then return 1
    return evalbody(ccdr[fn], env)
  end
  if t = 2 then return applyfn(fnof(fn), av, n)
  return lerror('the value ' || printobj(fn, 1) || ' is not a function')

call1: procedure = .int
  arg fn = .int, a = .int
  v = .int[]
  v[1] = a
  return applyfn(fn, v, 1)

call2: procedure = .int
  arg fn = .int, a = .int, b = .int
  v = .int[]
  v[1] = a
  v[2] = b
  return applyfn(fn, v, 2)

/* ------------------------------------------------------------ equality */
eql: procedure = .int
  arg a = .int, b = .int
  if a = b then return 1
  if a < 0 | b < 0 then return 0
  if a = 0 | b = 0 then return 0
  if ctag[a] <> ctag[b] then return 0
  if ctag[a] = 3 then do
    if cnum[a] = cnum[b] then return 1
    return 0
  end
  if ctag[a] = 8 then do
    if cext[a] = cext[b] then return 1
    return 0
  end
  return 0

equal: procedure = .int
  arg a = .int, b = .int
  do forever
    if eql(a, b) = 1 then return 1
    if a < 0 | b < 0 | a = 0 | b = 0 then return 0
    if ctag[a] <> ctag[b] then return 0
    t = ctag[a]
    if t = 4 then do
      if cstr[a] == cstr[b] then return 1
      return 0
    end
    if t = 1 then do
      if equal(ccar[a], ccar[b]) = 0 then return 0
      a = ccdr[a]
      b = ccdr[b]
    end
    else if t = 9 then do
      if ccdr[a] <> ccdr[b] then return 0
      do i = 0 to ccdr[a] - 1
        if equal(vdat[cext[a] + i], vdat[cext[b] + i]) = 0 then return 0
      end
      return 1
    end
    else return 0
  end
  return 0

equalp: procedure = .int
  arg a = .int, b = .int
  do forever
    if eql(a, b) = 1 then return 1
    if isnum(a) = 1 & isnum(b) = 1 then do
      if fval(a) = fval(b) then return 1
      return 0
    end
    if a < 0 | b < 0 | a = 0 | b = 0 then return 0
    if ctag[a] <> ctag[b] then return 0
    t = ctag[a]
    if t = 4 then do
      if upper(cstr[a]) == upper(cstr[b]) then return 1
      return 0
    end
    if t = 8 then do
      if upper(d2c(cext[a])) == upper(d2c(cext[b])) then return 1
      return 0
    end
    if t = 1 then do
      if equalp(ccar[a], ccar[b]) = 0 then return 0
      a = ccdr[a]
      b = ccdr[b]
    end
    else if t = 9 then do
      if ccdr[a] <> ccdr[b] then return 0
      do i = 0 to ccdr[a] - 1
        if equalp(vdat[cext[a] + i], vdat[cext[b] + i]) = 0 then return 0
      end
      return 1
    end
    else return 0
  end
  return 0

/* ------------------------------------------------------- special forms */
eval: procedure = .int
  arg x = .int, env = .int
  if x < 0 then return x
  tg = ctag[x]
  if tg = 2 then return symval(x, env)
  if tg <> 1 then return x
  ndepth = ndepth + 1
  if ndepth > maxdepth then do
    ndepth = ndepth - 1
    return lerror('evaluation nested too deeply (stack exhausted)')
  end
  r = eval1(x, env)
  ndepth = ndepth - 1
  return r

eval1: procedure = .int
  arg x = .int, env = .int
  av = .int[]
  do forever
    if x < 0 then return x
    t = ctag[x]
    if t = 2 then return symval(x, env)
    if t <> 1 then return x
    f = ccar[x]
    sid = 0
    fn = 0
    if f > 0 then do
      if ctag[f] = 2 then sid = cext[f]
    end
    if sid = 0 then do
      if f > 0 then do
        if ctag[f] = 1 then do
          if ccar[f] = sLAMBDA then do
            fn = mkclosure(car(cdr(f)), ccdr[ccdr[f]], env)
          end
          else return lerror('illegal function call')
        end
        else if ctag[f] = 2 then fn = getfn(f, env)
        else return lerror('illegal function call')
      end
      else return lerror('illegal function call')
      if unw <> 0 then return 1
      tf = ctag[fn]
      if tf = 6 then do
        n = evalargs(ccdr[x], env, av)
        if unw <> 0 then return 1
        env2 = bindparams(ccar[fn], av, n, cext[fn])
        if unw <> 0 then return 1
        x = evalprefix(ccdr[fn], env2)
        if x = 0 then return 1
        env = env2
      end
      else if tf = 5 then do
        n = evalargs(ccdr[x], env, av)
        if unw <> 0 then return 1
        id = cext[fn]
        if id <= 17 then do
          res = fastprim(id, av, n)
          if res <> 0 then return res
        end
        if n < pmin[id] then return lerror('too few arguments to ' || cstr[fn])
        if pmax[id] >= 0 & n > pmax[id] then return lerror('too many arguments to ' || cstr[fn])
        curfn = fn
        return callprim(id, av, n)
      end
      else if tf = 7 then do
        n = list2arr(ccdr[x], av)
        env2 = bindparams(ccar[fn], av, n, cext[fn])
        if unw <> 0 then return 1
        ex = evalbody(ccdr[fn], env2)
        if unw <> 0 then return 1
        if iscons(ex) = 1 then do
          ccar[x] = ccar[ex]
          ccdr[x] = ccdr[ex]
        end
        else x = ex
      end
      else return lerror('the value ' || printobj(fn, 1) || ' is not a function')
    end
    else if sid = 1 then return ccar[ccdr[x]]
    else if sid = 2 then do
      a = ccar[ccdr[x]]
      if iscons(a) = 1 then return mkclosure(car(cdr(a)), ccdr[ccdr[a]], env)
      return getfn(a, env)
    end
    else if sid = 3 then do
      p = ccdr[x]
      c = eval(ccar[p], env)
      if unw <> 0 then return 1
      p = ccdr[p]
      if c <> 1 then x = ccar[p]
      else do
        p = ccdr[p]
        if p = 1 then return 1
        x = ccar[p]
      end
    end
    else if sid = 4 then do
      x = evalprefix(ccdr[x], env)
      if x = 0 then return 1
    end
    else if sid = 5 | sid = 6 then do
      /* let, let* */
      bl = car(ccdr[x])
      body = ccdr[ccdr[x]]
      nenv = env
      ev = env
      if sid = 6 then ev = 0
      dyn = 1
      s = 0
      v = 1
      do while iscons(bl) = 1
        b = ccar[bl]
        if iscons(b) = 1 then do
          s = ccar[b]
          v = 1
          if ccdr[b] <> 1 then do
            if sid = 5 then v = eval(car(ccdr[b]), env)
            else v = eval(car(ccdr[b]), nenv)
          end
        end
        else do
          s = b
          v = 1
        end
        if unw <> 0 then do
          call undyn dyn
          return 1
        end
        if cspec[s] = 1 then do
          dyn = cons(cons(s, ccar[s]), dyn)
          ccar[s] = v
        end
        else nenv = cons(cons(s, v), nenv)
        bl = ccdr[bl]
      end
      if dyn = 1 then do
        x = evalprefix(body, nenv)
        if x = 0 then return 1
        env = nenv
      end
      else do
        r = evalbody(body, nenv)
        call undyn dyn
        return r
      end
    end
    else if sid = 7 then do
      cl = ccdr[x]
      found = 0
      do while iscons(cl) = 1 & found = 0
        c = ccar[cl]
        v = eval(ccar[c], env)
        if unw <> 0 then return 1
        if v <> 1 then do
          if ccdr[c] = 1 then return v
          x = evalprefix(ccdr[c], env)
          if x = 0 then return 1
          found = 1
        end
        cl = ccdr[cl]
      end
      if found = 0 then return 1
    end
    else if sid = 8 | sid = 13 then do
      k = eval(car(ccdr[x]), env)
      if unw <> 0 then return 1
      cl = ccdr[ccdr[x]]
      found = 0
      do while iscons(cl) = 1 & found = 0
        c = ccar[cl]
        ks = ccar[c]
        hit = 0
        if ks = 2 | ks = sOTHERWISE then hit = 1
        else if iscons(ks) = 1 then do
          do while iscons(ks) = 1
            if eql(ccar[ks], k) = 1 then hit = 1
            ks = ccdr[ks]
          end
        end
        else if eql(ks, k) = 1 then hit = 1
        if hit = 1 then do
          found = 1
          x = evalprefix(ccdr[c], env)
          if x = 0 then return 1
        end
        cl = ccdr[cl]
      end
      if found = 0 then do
        if sid = 13 then return lerror('no matching ECASE clause for ' || printobj(k, 1))
        return 1
      end
    end
    else if sid = 9 then do
      p = ccdr[x]
      if p = 1 then return 2
      do while ccdr[p] <> 1
        v = eval(ccar[p], env)
        if unw <> 0 then return 1
        if v = 1 then return 1
        p = ccdr[p]
      end
      x = ccar[p]
    end
    else if sid = 10 then do
      p = ccdr[x]
      if p = 1 then return 1
      do while ccdr[p] <> 1
        v = eval(ccar[p], env)
        if unw <> 0 then return 1
        if v <> 1 then return v
        p = ccdr[p]
      end
      x = ccar[p]
    end
    else if sid = 11 | sid = 12 then do
      c = eval(car(ccdr[x]), env)
      if unw <> 0 then return 1
      if sid = 11 & c = 1 then return 1
      if sid = 12 & c <> 1 then return 1
      x = evalprefix(ccdr[ccdr[x]], env)
      if x = 0 then return 1
    end
    else if sid = 14 then do
      /* loop: a simple loop or the extended form */
      if iscons(ccdr[x]) = 1 & iscons(car(ccdr[x])) = 1 then return simpleloop(ccdr[x], env)
      ccar[x] = sXLOOP
    end
    else return evalspecial(sid, x, env)
  end
  return 1

/* inline versions of the commonest primitives; 0 when not applicable */
fastprim: procedure = .int
  arg id = .int, expose av = .int[], n = .int
  if n = 2 then do
    a = av[1]
    b = av[2]
    if id = 3 then return cons(a, b)
    if id = 17 then do
      if a = b then return 2
      return 1
    end
    if a < 0 & b < 0 then do
      x = intval(a)
      y = intval(b)
      if id = 4 then return mkint(x + y)
      if id = 5 then return mkint(x - y)
      if id = 6 then return mkint(x * y)
      if id = 8 then do
        if x = y then return 2
        return 1
      end
      if id = 9 then do
        if x < y then return 2
        return 1
      end
      if id = 10 then do
        if x > y then return 2
        return 1
      end
      if id = 11 then do
        if x <= y then return 2
        return 1
      end
      if id = 12 then do
        if x >= y then return 2
        return 1
      end
    end
    return 0
  end
  if n = 1 then do
    a = av[1]
    if id = 1 then do
      if a = 1 then return 1
      if a > 0 then do
        if ctag[a] = 1 then return ccar[a]
      end
      return 0
    end
    if id = 2 then do
      if a = 1 then return 1
      if a > 0 then do
        if ctag[a] = 1 then return ccdr[a]
      end
      return 0
    end
    if id = 14 & a < 0 then return mkint(intval(a) + 1)
    if id = 15 & a < 0 then return mkint(intval(a) - 1)
    if id = 16 then do
      if a = 1 then return 2
      return 1
    end
  end
  return 0

/* restore dynamic bindings made by let */
undyn: procedure = .void
  arg d = .int
  do while d <> 1
    b = ccar[d]
    ccar[ccar[b]] = ccdr[b]
    d = ccdr[d]
  end
  return

simpleloop: procedure = .int
  arg body = .int, env = .int
  do forever
    p = body
    do while iscons(p) = 1
      junk = eval(ccar[p], env)
      if unw <> 0 then do
        if unw = 3 & unwtag = 1 then do
          unw = 0
          return unwval
        end
        return 1
      end
      p = ccdr[p]
    end
  end
  return 1

/* check for (return) out of a loop; returns 1 when the loop should stop */
loopexit: procedure = .int
  if unw = 0 then return 0
  return 1


/* status after evaluating something inside a loop body:
   0 carry on, 1 left by (return) with value in unwval, 2 other unwinding */
loopstat: procedure = .int
  if unw = 0 then return 0
  if unw = 3 & unwtag = 1 then do
    unw = 0
    return 1
  end
  return 2

blockwrap: procedure = .int
  arg name = .int, body = .int
  if hasreturn(body) = 1 then return list1(cons(sBLOCK, cons(name, body)))
  return body

stripdoc: procedure = .int
  arg body = .int
  if iscons(body) = 1 then do
    if isstring(ccar[body]) = 1 & ccdr[body] <> 1 then return ccdr[body]
  end
  return body

/* bind the pattern of destructuring-bind */
destruct: procedure = .int
  arg pat = .int, val = .int, env = .int
  mode = 0
  do while iscons(pat) = 1
    p = ccar[pat]
    if p = sOPT then mode = 1
    else if p = sREST | p = sBODY then mode = 2
    else if mode = 2 then do
      env = cons(cons(p, val), env)
      val = 1
      mode = 3
    end
    else if iscons(p) = 1 then do
      env = destruct(p, car(val), env)
      val = cdr(val)
    end
    else do
      if mode = 0 & val = 1 then return lerror('too few elements for destructuring')
      env = cons(cons(p, car(val)), env)
      val = cdr(val)
    end
    if unw <> 0 then return env
    pat = ccdr[pat]
  end
  if pat <> 1 then env = cons(cons(pat, val), env)
  return env

/* backquote */
qq: procedure = .int
  arg x = .int, env = .int
  if iscons(x) = 0 then return x
  if ccar[x] = sUNQ then return eval(car(ccdr[x]), env)
  res = 1
  p = x
  tail = 1
  dotted = 0
  do while iscons(p) = 1
    if ccar[p] = sUNQ then do
      tail = eval(car(ccdr[p]), env)
      dotted = 1
      p = 1
    end
    else do
      e = ccar[p]
      if iscons(e) = 1 & ccar[e] = sUNQS then do
        l = eval(car(ccdr[e]), env)
        if unw <> 0 then return 1
        do while iscons(l) = 1
          res = cons(ccar[l], res)
          l = ccdr[l]
        end
      end
      else do
        res = cons(qq(e, env), res)
        if unw <> 0 then return 1
      end
      p = ccdr[p]
    end
  end
  if dotted = 0 then tail = p
  do while res <> 1
    nx = ccdr[res]
    ccdr[res] = tail
    tail = res
    res = nx
  end
  return tail

/* does the condition type name match the pending error ? */
condmatch: procedure = .int
  arg ty = .int
  if ty = 2 then return 1
  nm = cstr[ty]
  if nm = 'ERROR' | nm = 'CONDITION' | nm = 'SERIOUS-CONDITION' then return 1
  if nm = errkind then return 1
  if nm = 'SIMPLE-ERROR' & errkind = 'ERROR' then return 1
  if nm = 'ARITHMETIC-ERROR' & errkind = 'DIVISION-BY-ZERO' then return 1
  if nm = 'CELL-ERROR' & (errkind = 'UNBOUND-VARIABLE' | errkind = 'UNDEFINED-FUNCTION') then return 1
  return 0

/* the place access functions used by setf, incf, push ... */
setplace: procedure = .int
  arg pl = .int, v = .int, env = .int
  if issym(pl) = 1 then return setvar(pl, v, env)
  if iscons(pl) = 0 then return lerror('invalid place')
  h = ccar[pl]
  a = ccdr[pl]
  if issym(h) = 0 then return lerror('invalid place')
  nm = cstr[h]
  if cslot[h] > 0 then do
    o = eval(car(a), env)
    if unw <> 0 then return 1
    if o <= 0 then return lerror('not a structure')
    if ctag[o] <> 11 then return lerror('not a structure')
    vdat[cext[o] + cslot[h] - 1] = v
    return v
  end
  if nm = 'GETHASH' then do
    k = eval(car(a), env)
    t = eval(car(cdr(a)), env)
    if unw <> 0 then return 1
    call htput t, k, v
    return v
  end
  if nm = 'GET' then do
    s = eval(car(a), env)
    k = eval(car(cdr(a)), env)
    if unw <> 0 then return 1
    call putprop s, k, v
    return v
  end
  if nm = 'SYMBOL-VALUE' then do
    s = eval(car(a), env)
    ccar[s] = v
    return v
  end
  o = eval(car(a), env)
  if unw <> 0 then return 1
  if nm = 'CAR' | nm = 'FIRST' then do
    if iscons(o) = 0 then return lerror('not a cons: ' || printobj(o, 1))
    ccar[o] = v
    return v
  end
  if nm = 'CDR' | nm = 'REST' then do
    if iscons(o) = 0 then return lerror('not a cons: ' || printobj(o, 1))
    ccdr[o] = v
    return v
  end
  if nm = 'CADR' | nm = 'SECOND' then do
    o = cdr(o)
    if iscons(o) = 0 then return lerror('not a cons')
    ccar[o] = v
    return v
  end
  if nm = 'THIRD' then do
    o = cdr(cdr(o))
    if iscons(o) = 0 then return lerror('not a cons')
    ccar[o] = v
    return v
  end
  if nm = 'CDDR' then do
    o = cdr(o)
    if iscons(o) = 0 then return lerror('not a cons')
    ccdr[o] = v
    return v
  end
  idx = eval(car(cdr(a)), env)
  if unw <> 0 then return 1
  if nm = 'NTH' then do
    tmp = idx
    idx = o
    o = tmp
  end
  if idx >= 0 then return lerror('bad index ' || printobj(idx, 1))
  i = intval(idx)
  if o = 1 | iscons(o) = 1 then do
    do while i > 0 & iscons(o) = 1
      o = ccdr[o]
      i = i - 1
    end
    if iscons(o) = 0 then return lerror('index too large')
    ccar[o] = v
    return v
  end
  if o > 0 then do
    if ctag[o] = 9 then do
      if i < 0 | i >= ccdr[o] then return lerror('index ' || i || ' out of bounds')
      vdat[cext[o] + i] = v
      return v
    end
    if ctag[o] = 4 then do
      s = cstr[o]
      if i < 0 | i >= length(s) then return lerror('index ' || i || ' out of bounds')
      cstr[o] = left(s, i) || d2c(cext[v]) || substr(s, i + 2)
      return v
    end
  end
  return lerror('invalid place: ' || printobj(pl, 1))

evalspecial: procedure = .int
  arg sid = .int, x = .int, env = .int
  if sid = 21 then do
    /* setq */
    p = ccdr[x]
    v = 1
    do while iscons(p) = 1
      v = eval(car(ccdr[p]), env)
      if unw <> 0 then return 1
      junk = setvar(ccar[p], v, env)
      if unw <> 0 then return 1
      p = ccdr[ccdr[p]]
    end
    return v
  end
  if sid = 22 then do
    /* defun */
    name = car(ccdr[x])
    params = car(ccdr[ccdr[x]])
    body = stripdoc(ccdr[ccdr[ccdr[x]]])
    c = mkclosure(params, blockwrap(name, body), env)
    cstr[c] = cstr[name]
    ccdr[name] = c
    return name
  end
  if sid = 23 | sid = 24 | sid = 51 then do
    /* defvar defparameter defconstant */
    name = car(ccdr[x])
    cspec[name] = 1
    if sid = 51 then cspec[name] = 2
    if sid = 24 | sid = 51 | ccar[name] = 0 then do
      init = car(ccdr[ccdr[x]])
      v = eval(init, env)
      if unw <> 0 then return 1
      ccar[name] = v
    end
    return name
  end
  if sid = 25 then do
    /* defmacro */
    name = car(ccdr[x])
    c = newcell(7)
    ccar[c] = car(ccdr[ccdr[x]])
    ccdr[c] = stripdoc(ccdr[ccdr[ccdr[x]]])
    cext[c] = env
    cstr[c] = cstr[name]
    ccdr[name] = c
    return name
  end
  if sid = 26 then return mkclosure(car(ccdr[x]), ccdr[ccdr[x]], env)
  if sid = 27 then do
    /* setf */
    p = ccdr[x]
    v = 1
    do while iscons(p) = 1
      v = eval(car(ccdr[p]), env)
      if unw <> 0 then return 1
      junk = setplace(ccar[p], v, env)
      if unw <> 0 then return 1
      p = ccdr[ccdr[p]]
    end
    return v
  end
  if sid = 28 | sid = 29 then do
    /* incf decf */
    pl = car(ccdr[x])
    cur = eval(pl, env)
    if unw <> 0 then return 1
    d = mkint(1)
    if ccdr[ccdr[x]] <> 1 then do
      d = eval(car(ccdr[ccdr[x]]), env)
      if unw <> 0 then return 1
    end
    if sid = 29 then d = numneg(d)
    v = numadd(cur, d)
    if unw <> 0 then return 1
    return setplace(pl, v, env)
  end
  if sid = 30 | sid = 52 then do
    /* push pushnew */
    v = eval(car(ccdr[x]), env)
    if unw <> 0 then return 1
    pl = car(ccdr[ccdr[x]])
    cur = eval(pl, env)
    if unw <> 0 then return 1
    if sid = 52 then do
      q = cur
      do while iscons(q) = 1
        if eql(ccar[q], v) = 1 then return cur
        q = ccdr[q]
      end
    end
    return setplace(pl, cons(v, cur), env)
  end
  if sid = 31 then do
    pl = car(ccdr[x])
    cur = eval(pl, env)
    if unw <> 0 then return 1
    junk = setplace(pl, cdr(cur), env)
    return car(cur)
  end
  if sid = 32 | sid = 33 then do
    /* do, do* */
    specs = car(ccdr[x])
    endc = car(ccdr[ccdr[x]])
    body = ccdr[ccdr[ccdr[x]]]
    nenv = env
    blist = 1
    slist = 1
    p = specs
    do while iscons(p) = 1
      spc = ccar[p]
      stp = 1
      init = 1
      vrb = spc
      if iscons(spc) = 1 then do
        vrb = ccar[spc]
        init = car(ccdr[spc])
        stp = ccdr[ccdr[spc]]
      end
      if sid = 32 then v = eval(init, env)
      else v = eval(init, nenv)
      if unw <> 0 then return 1
      b = cons(vrb, v)
      nenv = cons(b, nenv)
      blist = cons(b, blist)
      slist = cons(stp, slist)
      p = ccdr[p]
    end
    blist = nreverse(blist)
    slist = nreverse(slist)
    vals = .int[]
    do forever
      t = eval(car(endc), nenv)
      if unw <> 0 then return 1
      if t <> 1 then return evalbody(cdr(endc), nenv)
      q = body
      do while iscons(q) = 1
        junk = eval(ccar[q], nenv)
        st = loopstat()
        if st = 1 then return unwval
        if st = 2 then return 1
        q = ccdr[q]
      end
      bl = blist
      sl = slist
      k = 0
      do while iscons(bl) = 1
        k = k + 1
        if ccar[sl] <> 1 then do
          v = eval(car(ccar[sl]), nenv)
          if unw <> 0 then return 1
          if sid = 33 then ccdr[ccar[bl]] = v
          else vals[k] = v
        end
        else vals[k] = ccdr[ccar[bl]]
        bl = ccdr[bl]
        sl = ccdr[sl]
      end
      if sid = 32 then do
        bl = blist
        k = 0
        do while iscons(bl) = 1
          k = k + 1
          ccdr[ccar[bl]] = vals[k]
          bl = ccdr[bl]
        end
      end
    end
  end
  if sid = 34 then do
    /* dolist */
    spec = car(ccdr[x])
    vrb = car(spec)
    l = eval(car(cdr(spec)), env)
    if unw <> 0 then return 1
    b = cons(vrb, 1)
    nenv = cons(b, env)
    body = ccdr[ccdr[x]]
    fresh = hasclosure(body)
    do while iscons(l) = 1
      if fresh = 1 then do
        b = cons(vrb, 1)
        nenv = cons(b, env)
      end
      ccdr[b] = ccar[l]
      q = body
      do while iscons(q) = 1
        junk = eval(ccar[q], nenv)
        st = loopstat()
        if st = 1 then return unwval
        if st = 2 then return 1
        q = ccdr[q]
      end
      l = ccdr[l]
    end
    nenv = cons(cons(vrb, 1), env)
    r = car(cdr(cdr(spec)))
    return eval(r, nenv)
  end
  if sid = 35 then do
    /* dotimes */
    spec = car(ccdr[x])
    vrb = car(spec)
    cnt = eval(car(cdr(spec)), env)
    if unw <> 0 then return 1
    if cnt >= 0 then return lerror('dotimes needs an integer count')
    nmax = intval(cnt)
    b = cons(vrb, 1)
    nenv = cons(b, env)
    body = ccdr[ccdr[x]]
    fresh = hasclosure(body)
    do i = 0 to nmax - 1
      if fresh = 1 then do
        b = cons(vrb, 1)
        nenv = cons(b, env)
      end
      ccdr[b] = mkint(i)
      q = body
      do while iscons(q) = 1
        junk = eval(ccar[q], nenv)
        st = loopstat()
        if st = 1 then return unwval
        if st = 2 then return 1
        q = ccdr[q]
      end
    end
    nenv = cons(cons(vrb, mkint(nmax)), env)
    r = car(cdr(cdr(spec)))
    return eval(r, nenv)
  end
  if sid = 37 | sid = 38 then do
    /* flet, labels */
    hasfenv = 1
    nenv = env
    cl = 1
    p = car(ccdr[x])
    do while iscons(p) = 1
      d = ccar[p]
      name = ccar[d]
      c = mkclosure(car(ccdr[d]), blockwrap(name, ccdr[ccdr[d]]), env)
      cstr[c] = cstr[name]
      nenv = cons(cons(fkey(name), c), nenv)
      cl = cons(c, cl)
      p = ccdr[p]
    end
    if sid = 38 then do
      do while iscons(cl) = 1
        cext[ccar[cl]] = nenv
        cl = ccdr[cl]
      end
    end
    return evalbody(ccdr[ccdr[x]], nenv)
  end
  if sid = 39 then do
    name = car(ccdr[x])
    r = evalbody(ccdr[ccdr[x]], env)
    if unw = 3 & unwtag = name then do
      unw = 0
      r = unwval
    end
    return r
  end
  if sid = 40 | sid = 41 then do
    tag = 1
    vf = 1
    if sid = 40 then do
      tag = car(ccdr[x])
      vf = car(ccdr[ccdr[x]])
    end
    else do
      tag = 1
      vf = car(ccdr[x])
    end
    v = eval(vf, env)
    if unw <> 0 then return 1
    unw = 3
    unwtag = tag
    unwval = v
    return 1
  end
  if sid = 42 then do
    tag = eval(car(ccdr[x]), env)
    if unw <> 0 then return 1
    catchtags = cons(tag, catchtags)
    r = evalbody(ccdr[ccdr[x]], env)
    catchtags = ccdr[catchtags]
    if unw = 2 & eql(unwtag, tag) = 1 then do
      unw = 0
      r = unwval
    end
    return r
  end
  if sid = 43 then do
    tag = eval(car(ccdr[x]), env)
    if unw <> 0 then return 1
    v = eval(car(ccdr[ccdr[x]]), env)
    if unw <> 0 then return 1
    q = catchtags
    found = 0
    do while iscons(q) = 1
      if eql(ccar[q], tag) = 1 then found = 1
      q = ccdr[q]
    end
    if found = 0 then return lerrk('CONTROL-ERROR', 'attempt to throw to a tag that does not exist: ' || printobj(tag, 1))
    unw = 2
    unwtag = tag
    unwval = v
    return 1
  end
  if sid = 44 then do
    /* handler-case */
    r = eval(car(ccdr[x]), env)
    if unw = 1 then do
      cl = ccdr[ccdr[x]]
      do while iscons(cl) = 1
        c = ccar[cl]
        if condmatch(ccar[c]) = 1 then do
          cond = mkstr(errmsg)
          unw = 0
          nenv = env
          vr = car(car(ccdr[c]))
          if vr <> 1 then nenv = cons(cons(vr, cond), env)
          return evalbody(ccdr[ccdr[c]], nenv)
        end
        cl = ccdr[cl]
      end
    end
    return r
  end
  if sid = 45 then do
    r = evalbody(ccdr[x], env)
    if unw = 1 then do
      unw = 0
      return 1
    end
    return r
  end
  if sid = 46 then do
    r = eval(car(ccdr[x]), env)
    su = unw
    st = unwtag
    sv = unwval
    sm = errmsg
    sk = errkind
    unw = 0
    junk = evalbody(ccdr[ccdr[x]], env)
    if unw = 0 then do
      unw = su
      unwtag = st
      unwval = sv
      errmsg = sm
      errkind = sk
    end
    return r
  end
  if sid = 47 then return qq(car(ccdr[x]), env)
  if sid = 48 then return eval(car(ccdr[ccdr[x]]), env)
  if sid = 49 then return 1
  if sid = 50 then return defstruct(x, env)
  if sid = 53 then do
    v = eval(car(ccdr[x]), env)
    if unw <> 0 then return 1
    if v = 1 then return lerror('assertion failed: ' || printobj(car(ccdr[x]), 1))
    return 1
  end
  if sid = 54 then do
    /* multiple-value-bind */
    mvlist = 0
    r = eval(car(ccdr[ccdr[x]]), env)
    if unw <> 0 then return 1
    vals = mvlist
    if vals = 0 then vals = list1(r)
    mvlist = 0
    nenv = env
    vs = car(ccdr[x])
    do while iscons(vs) = 1
      nenv = cons(cons(ccar[vs], car(vals)), nenv)
      vals = cdr(vals)
      vs = ccdr[vs]
    end
    return evalbody(ccdr[ccdr[ccdr[x]]], nenv)
  end
  if sid = 55 then do
    /* with-output-to-string */
    old = capbuf
    capbuf = ''
    capdepth = capdepth + 1
    nenv = cons(cons(car(car(ccdr[x])), 2), env)
    r = evalbody(ccdr[ccdr[x]], nenv)
    capdepth = capdepth - 1
    res = capbuf
    capbuf = old
    return mkstr(res)
  end
  if sid = 56 | sid = 57 then do
    /* prog1 prog2 */
    body = ccdr[x]
    if sid = 57 then do
      junk = eval(ccar[body], env)
      if unw <> 0 then return 1
      body = ccdr[body]
    end
    r = eval(ccar[body], env)
    if unw <> 0 then return 1
    junk = evalbody(ccdr[body], env)
    return r
  end
  if sid = 58 then do
    v = eval(car(ccdr[ccdr[x]]), env)
    if unw <> 0 then return 1
    nenv = destruct(car(ccdr[x]), v, env)
    if unw <> 0 then return 1
    return evalbody(ccdr[ccdr[ccdr[x]]], nenv)
  end
  if sid = 59 then do
    /* typecase */
    k = eval(car(ccdr[x]), env)
    if unw <> 0 then return 1
    cl = ccdr[ccdr[x]]
    do while iscons(cl) = 1
      c = ccar[cl]
      ty = ccar[c]
      if ty = 2 | ty = sOTHERWISE then return evalbody(ccdr[c], env)
      if typep(k, ty) = 1 then return evalbody(ccdr[c], env)
      cl = ccdr[cl]
    end
    return 1
  end
  if sid = 60 then return eval(car(ccdr[x]), env)
  if sid = 61 then do
    mvlist = 0
    r = eval(car(ccdr[x]), env)
    if unw <> 0 then return 1
    if mvlist <> 0 then do
      l = mvlist
      mvlist = 0
      return l
    end
    return list1(r)
  end
  if sid = 62 then do
    /* nth-value */
    nn = eval(car(ccdr[x]), env)
    mvlist = 0
    r = eval(car(ccdr[ccdr[x]]), env)
    if unw <> 0 then return 1
    vals = mvlist
    if vals = 0 then vals = list1(r)
    mvlist = 0
    do i = 1 to intval(nn)
      vals = cdr(vals)
    end
    return car(vals)
  end
  if sid = 63 then do
    /* rotatef */
    pls = ccdr[x]
    if pls = 1 then return 1
    first = ccar[pls]
    cur = eval(first, env)
    p = pls
    do while ccdr[p] <> 1
      nxt = eval(ccar[ccdr[p]], env)
      junk = setplace(ccar[p], nxt, env)
      p = ccdr[p]
    end
    junk = setplace(ccar[p], cur, env)
    return 1
  end
  if sid = 64 then do
    /* psetq */
    p = ccdr[x]
    tmp = 1
    q = p
    do while iscons(q) = 1
      tmp = cons(eval(car(ccdr[q]), env), tmp)
      q = ccdr[ccdr[q]]
    end
    tmp = nreverse(tmp)
    do while iscons(p) = 1
      junk = setvar(ccar[p], ccar[tmp], env)
      tmp = ccdr[tmp]
      p = ccdr[ccdr[p]]
    end
    return 1
  end
  return lerror('unknown special form ' || sid)


/* ===================================================================== */
/*                       NUMBERS, TABLES, STRUCTURES                     */
/* ===================================================================== */
lerrk: procedure = .int
  arg kind = .string, msg = .string
  if unw = 0 then do
    unw = 1
    errmsg = msg
    errkind = kind
  end
  return 1

notnum: procedure = .int
  arg a = .int
  return lerrk('TYPE-ERROR', 'the value ' || printobj(a, 1) || ' is not of type NUMBER')

numadd: procedure = .int
  arg a = .int, b = .int
  if a < 0 & b < 0 then return mkint(intval(a) + intval(b))
  if isnum(a) = 0 then return notnum(a)
  if isnum(b) = 0 then return notnum(b)
  return mkfloat(fval(a) + fval(b))

numsub: procedure = .int
  arg a = .int, b = .int
  if a < 0 & b < 0 then return mkint(intval(a) - intval(b))
  if isnum(a) = 0 then return notnum(a)
  if isnum(b) = 0 then return notnum(b)
  return mkfloat(fval(a) - fval(b))

nummul: procedure = .int
  arg a = .int, b = .int
  if a < 0 & b < 0 then return mkint(intval(a) * intval(b))
  if isnum(a) = 0 then return notnum(a)
  if isnum(b) = 0 then return notnum(b)
  return mkfloat(fval(a) * fval(b))

numneg: procedure = .int
  arg a = .int
  return numsub(mkint(0), a)

numdiv: procedure = .int
  arg a = .int, b = .int
  if isnum(a) = 0 then return notnum(a)
  if isnum(b) = 0 then return notnum(b)
  if a < 0 & b < 0 then do
    x = intval(a)
    y = intval(b)
    if y = 0 then return lerrk('DIVISION-BY-ZERO', 'arithmetic error DIVISION-BY-ZERO signalled')
    if x % y = 0 then return mkint(x / y)
    return mkfloat(x / (y * 1.0))
  end
  d = fval(b)
  if d = 0.0 then return lerrk('DIVISION-BY-ZERO', 'arithmetic error DIVISION-BY-ZERO signalled')
  return mkfloat(fval(a) / d)

/* -1, 0, 1 */
numcmp: procedure = .int
  arg a = .int, b = .int
  if a < 0 & b < 0 then do
    x = intval(a)
    y = intval(b)
    if x < y then return -1
    if x > y then return 1
    return 0
  end
  if isnum(a) = 0 then do
    junk = notnum(a)
    return 0
  end
  if isnum(b) = 0 then do
    junk = notnum(b)
    return 0
  end
  x = fval(a)
  y = fval(b)
  if x < y then return -1
  if x > y then return 1
  return 0

/* integer or float to a Level B integer (truncating) */
toint: procedure = .int
  arg a = .int
  if a < 0 then return intval(a)
  if isfloat(a) = 1 then do
    t = trunc(cnum[a])
    v = t as .int
    return v
  end
  junk = lerrk('TYPE-ERROR', 'the value ' || printobj(a, 1) || ' is not of type INTEGER')
  return 0

/* ---------------------------------------------------------------- math */
lsqrt: procedure = .float
  arg x = .float
  if x <= 0.0 then return 0.0
  m = x
  e = 0
  do while m >= 4.0
    m = m / 4.0
    e = e + 1
  end
  do while m < 0.25
    m = m * 4.0
    e = e - 1
  end
  r = (1.0 + m) / 2.0
  do 8
    r = (r + m / r) / 2.0
  end
  do while e > 0
    r = r * 2.0
    e = e - 1
  end
  do while e < 0
    r = r / 2.0
    e = e + 1
  end
  return r

lsin: procedure = .float
  arg x = .float
  pi = 3.14159265358979323846
  twopi = 6.28318530717958647692
  r = x
  if r > twopi | r < 0.0 - twopi then do
    q = trunc(r / twopi) as .int
    r = r - q * twopi
  end
  if r > pi then r = r - twopi
  if r < 0.0 - pi then r = r + twopi
  if r > pi / 2.0 then r = pi - r
  if r < 0.0 - pi / 2.0 then r = 0.0 - pi - r
  r2 = r * r
  term = r
  sum = r
  do k = 1 to 12
    term = 0.0 - term * r2 / ((2 * k) * (2 * k + 1))
    sum = sum + term
  end
  return sum

lcos: procedure = .float
  arg x = .float
  return lsin(x + 1.57079632679489661923)

latan: procedure = .float
  arg x = .float
  neg = 0
  a = x
  if a < 0.0 then do
    neg = 1
    a = 0.0 - a
  end
  inv = 0
  if a > 1.0 then do
    inv = 1
    a = 1.0 / a
  end
  do 3
    a = a / (1.0 + lsqrt(1.0 + a * a))
  end
  a2 = a * a
  term = a
  sum = a
  do k = 1 to 14
    term = 0.0 - term * a2
    sum = sum + term / (2 * k + 1)
  end
  sum = sum * 8.0
  if inv = 1 then sum = 1.57079632679489661923 - sum
  if neg = 1 then sum = 0.0 - sum
  return sum

lln: procedure = .float
  arg x = .float
  e = 0
  m = x
  do while m >= 2.0
    m = m / 2.0
    e = e + 1
  end
  do while m < 0.5
    m = m * 2.0
    e = e - 1
  end
  z = (m - 1.0) / (m + 1.0)
  z2 = z * z
  term = z
  sum = z
  do k = 1 to 30
    term = term * z2
    sum = sum + term / (2 * k + 1)
  end
  return 2.0 * sum + e * 0.69314718055994530942

lexp: procedure = .float
  arg x = .float
  k = 0
  r = x
  do while r > 0.5 | r < -0.5
    r = r / 2.0
    k = k + 1
  end
  term = 1.0
  sum = 1.0
  do i = 1 to 20
    term = term * r / i
    sum = sum + term
  end
  do k
    sum = sum * sum
  end
  return sum

/* integer power by repeated squaring */
ipow: procedure = .int
  arg b = .int, e = .int
  r = 1
  do while e > 0
    if e % 2 = 1 then r = r * b
    b = b * b
    e = e / 2
  end
  return r

nextrand: procedure = .int
  seed = (seed * 1103515245 + 12345) % 2147483648
  return seed

/* ---------------------------------------------------------- hash tables */
mkhash: procedure = .int
  arg mode = .string
  c = newcell(10)
  nht = nht + 1
  cext[c] = nht * 1024
  cstr[c] = mode
  ccar[c] = 0
  ccdr[c] = 0
  chn[c] = 0
  return c

hkey: procedure = .int
  arg t = .int, k = .int
  mode = cstr[t]
  h = 0
  if k < 0 then h = intval(k)
  else if k = 0 then h = 0
  else do
    tg = ctag[k]
    if tg = 3 then do
      q = trunc(cnum[k])
      h = q as .int
    end
    else if tg = 4 then do
      if mode = '0' then h = k
      else if mode = '1' then h = hashname(cstr[k])
      else h = hashname(upper(cstr[k]))
    end
    else if tg = 8 then h = cext[k]
    else if tg = 1 | tg = 9 then do
      if mode = '0' then h = k
      else h = hashname(printobj(k, 1))
    end
    else h = k
  end
  if h < 0 then h = 0 - h
  return h % 1024

hkeq: procedure = .int
  arg t = .int, a = .int, b = .int
  mode = cstr[t]
  if mode = '0' then return eql(a, b)
  if mode = '1' then return equal(a, b)
  return equalp(a, b)

htfind: procedure = .int
  arg t = .int, k = .int
  e = htb[cext[t] + hkey(t, k)]
  do while e <> 0
    if hkeq(t, htk[e], k) = 1 then return e
    e = htn[e]
  end
  return 0

htput: procedure = .void
  arg t = .int, k = .int, v = .int
  e = htfind(t, k)
  if e > 0 then do
    htv[e] = v
    return
  end
  b = cext[t] + hkey(t, k)
  nhte = nhte + 1
  e = nhte
  htk[e] = k
  htv[e] = v
  htn[e] = htb[b]
  htb[b] = e
  hto[e] = 0
  hpv[e] = chn[t]
  if chn[t] <> 0 then hto[chn[t]] = e
  else ccar[t] = e
  chn[t] = e
  ccdr[t] = ccdr[t] + 1
  return

htrem: procedure = .int
  arg t = .int, k = .int
  b = cext[t] + hkey(t, k)
  e = htb[b]
  prev = 0
  do while e <> 0
    if hkeq(t, htk[e], k) = 1 then do
      if prev = 0 then htb[b] = htn[e]
      else htn[prev] = htn[e]
      if hpv[e] <> 0 then hto[hpv[e]] = hto[e]
      else ccar[t] = hto[e]
      if hto[e] <> 0 then hpv[hto[e]] = hpv[e]
      else chn[t] = hpv[e]
      ccdr[t] = ccdr[t] - 1
      return 1
    end
    prev = e
    e = htn[e]
  end
  return 0

htclear: procedure = .void
  arg t = .int
  e = ccar[t]
  do while e <> 0
    htb[cext[t] + hkey(t, htk[e])] = 0
    e = hto[e]
  end
  ccar[t] = 0
  chn[t] = 0
  ccdr[t] = 0
  return

/* ---------------------------------------------------- property lists */
getprop: procedure = .int
  arg s = .int, k = .int
  p = cpl[s]
  do while iscons(p) = 1
    if ccar[ccar[p]] = k then return ccdr[ccar[p]]
    p = ccdr[p]
  end
  return 1

putprop: procedure = .void
  arg s = .int, k = .int, v = .int
  p = cpl[s]
  do while iscons(p) = 1
    if ccar[ccar[p]] = k then do
      ccdr[ccar[p]] = v
      return
    end
    p = ccdr[p]
  end
  if cpl[s] = 0 then cpl[s] = 1
  cpl[s] = cons(cons(k, v), cpl[s])
  return

/* -------------------------------------------------------------- types */
typep: procedure = .int
  arg o = .int, ty = .int
  if ty = 2 then return 1
  if ty = 1 then return 0
  if iscons(ty) = 1 then do
    h = cstr[ccar[ty]]
    if h = 'OR' then do
      p = ccdr[ty]
      do while iscons(p) = 1
        if typep(o, ccar[p]) = 1 then return 1
        p = ccdr[p]
      end
      return 0
    end
    if h = 'AND' then do
      p = ccdr[ty]
      do while iscons(p) = 1
        if typep(o, ccar[p]) = 0 then return 0
        p = ccdr[p]
      end
      return 1
    end
    if h = 'NOT' then return 1 - typep(o, car(ccdr[ty]))
    if h = 'MEMBER' then do
      p = ccdr[ty]
      do while iscons(p) = 1
        if eql(o, ccar[p]) = 1 then return 1
        p = ccdr[p]
      end
      return 0
    end
    if h = 'INTEGER' then do
      if o >= 0 then return 0
      lo = car(ccdr[ty])
      hi = car(cdr(ccdr[ty]))
      if lo < 0 then do
        if intval(o) < intval(lo) then return 0
      end
      if hi < 0 then do
        if intval(o) > intval(hi) then return 0
      end
      return 1
    end
    return 0
  end
  nm = cstr[ty]
  if nm = 'INTEGER' | nm = 'FIXNUM' | nm = 'RATIONAL' | nm = 'BIGNUM' then do
    if o < 0 then return 1
    return 0
  end
  if nm = 'NUMBER' | nm = 'REAL' then return isnum(o)
  if nm = 'FLOAT' | nm = 'SINGLE-FLOAT' | nm = 'DOUBLE-FLOAT' then return isfloat(o)
  if nm = 'STRING' | nm = 'SIMPLE-STRING' then return isstring(o)
  if nm = 'SYMBOL' then return issym(o)
  if nm = 'KEYWORD' then do
    if issym(o) = 1 then do
      if left(cstr[o], 1) = ':' then return 1
    end
    return 0
  end
  if nm = 'LIST' then do
    if o = 1 then return 1
    return iscons(o)
  end
  if nm = 'CONS' then return iscons(o)
  if nm = 'NULL' then do
    if o = 1 then return 1
    return 0
  end
  if nm = 'ATOM' then return 1 - iscons(o)
  if nm = 'CHARACTER' then return ischar(o)
  if nm = 'BOOLEAN' then do
    if o = 1 | o = 2 then return 1
    return 0
  end
  if nm = 'FUNCTION' | nm = 'COMPILED-FUNCTION' then do
    if o > 0 then do
      if ctag[o] = 5 | ctag[o] = 6 then return 1
    end
    return 0
  end
  if nm = 'VECTOR' | nm = 'ARRAY' | nm = 'SIMPLE-VECTOR' then do
    if o > 0 then do
      if ctag[o] = 9 then return 1
      if nm <> 'SIMPLE-VECTOR' & ctag[o] = 4 then return 1
    end
    return 0
  end
  if nm = 'SEQUENCE' then do
    if o = 1 | iscons(o) = 1 then return 1
    if o > 0 then do
      if ctag[o] = 9 | ctag[o] = 4 then return 1
    end
    return 0
  end
  if nm = 'HASH-TABLE' then do
    if o > 0 then do
      if ctag[o] = 10 then return 1
    end
    return 0
  end
  if o > 0 then do
    if ctag[o] = 11 then do
      if cstr[ccar[o]] == nm then return 1
    end
  end
  return 0

lobjtype: procedure = .int
  arg o = .int
  if o < 0 then return intern('INTEGER')
  if o = 1 then return intern('NULL')
  if o = 2 then return intern('BOOLEAN')
  t = ctag[o]
  if t = 1 then return intern('CONS')
  if t = 2 then do
    if left(cstr[o], 1) = ':' then return intern('KEYWORD')
    return intern('SYMBOL')
  end
  if t = 3 then return intern('SINGLE-FLOAT')
  if t = 4 then return intern('STRING')
  if t = 5 | t = 6 then return intern('FUNCTION')
  if t = 8 then return intern('CHARACTER')
  if t = 9 then return intern('VECTOR')
  if t = 10 then return intern('HASH-TABLE')
  if t = 11 then return intern(cstr[ccar[o]])
  return intern('T')

/* ----------------------------------------------------------- defstruct */
pidof: procedure = .int
  arg name = .string
  return cext[ccdr[intern(name)]]

defstruct: procedure = .int
  arg x = .int, env = .int
  spec = car(ccdr[x])
  name = spec
  if iscons(spec) = 1 then name = ccar[spec]
  nm = cstr[name]
  sl = stripdoc2(ccdr[ccdr[x]])
  ty = newcell(13)
  cstr[ty] = nm
  syms = 1
  dfl = 1
  do while iscons(sl) = 1
    sp = ccar[sl]
    d = 1
    s = sp
    if iscons(sp) = 1 then do
      s = ccar[sp]
      d = car(ccdr[sp])
    end
    syms = cons(s, syms)
    dfl = cons(d, dfl)
    sl = ccdr[sl]
  end
  ccdr[ty] = nreverse(syms)
  ccar[ty] = nreverse(dfl)
  mk = newcell(5)
  cext[mk] = pidof('%MKSTRUCT')
  cstr[mk] = 'MAKE-' || nm
  ccar[mk] = ty
  ccdr[intern('MAKE-' || nm)] = mk
  pr = newcell(5)
  cext[pr] = pidof('%STRUCTP')
  cstr[pr] = nm || '-P'
  ccar[pr] = ty
  ccdr[intern(nm || '-P')] = pr
  cp = newcell(5)
  cext[cp] = pidof('%COPYSTRUCT')
  cstr[cp] = 'COPY-' || nm
  ccar[cp] = ty
  ccdr[intern('COPY-' || nm)] = cp
  p = ccdr[ty]
  i = 0
  do while iscons(p) = 1
    an = nm || '-' || cstr[ccar[p]]
    asym = intern(an)
    ac = newcell(5)
    cext[ac] = pidof('%STRUCTGET')
    cstr[ac] = an
    ccar[ac] = mkint(i)
    ccdr[ac] = ty
    ccdr[asym] = ac
    cslot[asym] = i + 1
    i = i + 1
    p = ccdr[p]
  end
  return name

stripdoc2: procedure = .int
  arg l = .int
  if iscons(l) = 1 then do
    if isstring(ccar[l]) = 1 then return ccdr[l]
  end
  return l


/* ===================================================================== */
/*                                FORMAT                                 */
/* ===================================================================== */
radixstr: procedure = .string
  arg n = .int, base = .int
  if n = 0 then return '0'
  neg = 0
  if n < 0 then do
    neg = 1
    n = 0 - n
  end
  s = ''
  digs = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ'
  do while n > 0
    q = n / base
    r = n - q * base
    s = substr(digs, r + 1, 1) || s
    n = q
  end
  if neg = 1 then s = '-' || s
  return s

commas: procedure = .string
  arg s = .string
  neg = 0
  if left(s, 1) = '-' then do
    neg = 1
    s = substr(s, 2)
  end
  o = ''
  do while length(s) > 3
    o = ',' || right(s, 3) || o
    s = left(s, length(s) - 3)
  end
  o = s || o
  if neg = 1 then o = '-' || o
  return o

/* x with d digits after the decimal point */
fixedfmt: procedure = .string
  arg x = .float, d = .int
  neg = 0
  if x < 0.0 then do
    neg = 1
    x = 0.0 - x
  end
  sc = 1
  do d
    sc = sc * 10
  end
  r = trunc(x * sc + 0.5) as .int
  s = r || ''
  if d > 0 then do
    do while length(s) <= d
      s = '0' || s
    end
    s = left(s, length(s) - d) || '.' || right(s, d)
  end
  if neg = 1 & r <> 0 then s = '-' || s
  return s

fmtpad: procedure = .string
  arg s = .string, w = .int, padc = .string, leftpad = .int
  if w <= length(s) then return s
  if leftpad = 1 then return copies(padc, w - length(s)) || s
  return s || copies(padc, w - length(s))

/* find the closing directive for an opener; fsemi gets the ~; positions */
fmtfind: procedure = .int
  arg ctl = .string, start = .int
  len = length(ctl)
  depth = 0
  fsemi = ''
  i = start
  do while i <= len
    if substr(ctl, i, 1) = '~' then do
      j = i + 1
      colon = 0
      do while j <= len & pos(substr(ctl, j, 1), '0123456789,-+#vV:@') > 0
        if substr(ctl, j, 1) = ':' then colon = 1
        j = j + 1
      end
      if substr(ctl, j, 1) = "'" then j = j + 2
      do while j <= len & pos(substr(ctl, j, 1), ':@') > 0
        if substr(ctl, j, 1) = ':' then colon = 1
        j = j + 1
      end
      dch = substr(ctl, j, 1)
      if pos(dch, '[{(<') > 0 then depth = depth + 1
      else if pos(dch, ']})>') > 0 then do
        if depth = 0 then return i
        depth = depth - 1
      end
      else if dch = ';' & depth = 0 then do
        if colon = 1 then fsemi = fsemi || i || 'c '
        else fsemi = fsemi || i || ' '
      end
      i = j + 1
    end
    else i = i + 1
  end
  return 0

fmtarg: procedure = .int
  arg expose fav = .int[], fnn = .int
  if fidx > fnn then return lerror('not enough arguments for FORMAT')
  v = fav[fidx]
  fidx = fidx + 1
  return v

fmtrun: procedure = .string
  arg ctl = .string, expose fav = .int[], fnn = .int
  out = ''
  i = 1
  len = length(ctl)
  pm = .int[]
  do while i <= len
    c = substr(ctl, i, 1)
    if c <> '~' then do
      j = pos('~', ctl, i)
      if j = 0 then j = len + 1
      out = out || substr(ctl, i, j - i)
      i = j
    end
    else do
      i = i + 1
      pc = 0
      colon = 0
      at = 0
      do forever
        d = substr(ctl, i, 1)
        if length(d) = 0 then leave
        if pos(d, '0123456789-+') > 0 then do
          j = i
          i = i + 1
          do while pos(substr(ctl, i, 1), '0123456789') > 0
            i = i + 1
          end
          pc = pc + 1
          pm[pc] = substr(ctl, j, i - j) as .int
        end
        else if d = "'" then do
          pc = pc + 1
          pm[pc] = c2d(substr(ctl, i + 1, 1))
          i = i + 2
        end
        else if d = 'v' | d = 'V' then do
          pc = pc + 1
          pm[pc] = toint(fmtarg(fav, fnn))
          i = i + 1
        end
        else if d = '#' then do
          pc = pc + 1
          pm[pc] = fnn - fidx + 1
          i = i + 1
        end
        else if d = ',' then do
          if pc = 0 then pc = 1
          i = i + 1
          if substr(ctl, i, 1) = ',' then do
            pc = pc + 1
            pm[pc] = -999999
          end
        end
        else leave
      end
      do while substr(ctl, i, 1) = ':' | substr(ctl, i, 1) = '@'
        if substr(ctl, i, 1) = ':' then colon = 1
        else at = 1
        i = i + 1
      end
      dch = upper(substr(ctl, i, 1))
      i = i + 1
      if unw <> 0 then return out
      if dch = 'A' | dch = 'S' then do
        v = fmtarg(fav, fnn)
        if unw <> 0 then return out
        if dch = 'A' then s = printobj(v, 0)
        else s = printobj(v, 1)
        if pc >= 1 then s = fmtpad(s, pm[1], ' ', at)
        out = out || s
      end
      else if dch = 'D' | dch = 'B' | dch = 'O' | dch = 'X' then do
        v = fmtarg(fav, fnn)
        if unw <> 0 then return out
        s = printobj(v, 0)
        if isint(v) = 1 then do
          base = 10
          if dch = 'B' then base = 2
          if dch = 'O' then base = 8
          if dch = 'X' then base = 16
          if base <> 10 then s = radixstr(intval(v), base)
        end
        if colon = 1 & dch = 'D' & isint(v) = 1 then s = commas(s)
        if at = 1 & isint(v) = 1 then do
          if intval(v) >= 0 then s = '+' || s
        end
        pch = ' '
        if pc >= 2 then do
          if pm[2] <> -999999 then pch = d2c(pm[2])
        end
        if pc >= 1 then s = fmtpad(s, pm[1], pch, 1)
        out = out || s
      end
      else if dch = 'F' | dch = '$' then do
        v = fmtarg(fav, fnn)
        if unw <> 0 then return out
        if isnum(v) = 0 then s = printobj(v, 0)
        else do
          dd = -1
          w = 0
          if dch = '$' then do
            dd = 2
            if pc >= 1 then dd = pm[1]
          end
          else do
            if pc >= 2 then dd = pm[2]
            if pc >= 1 then w = pm[1]
          end
          if dd >= 0 then s = fixedfmt(fval(v), dd)
          else s = printobj(mkfloat(fval(v)), 0)
          if dch = 'F' & pc >= 1 then s = fmtpad(s, w, ' ', 1)
        end
        out = out || s
      end
      else if dch = 'C' then do
        v = fmtarg(fav, fnn)
        if unw <> 0 then return out
        if ischar(v) = 1 then out = out || printobj(v, 0)
        else out = out || printobj(v, 0)
      end
      else if dch = '%' then do
        cnt = 1
        if pc >= 1 then cnt = pm[1]
        out = out || copies('0a'x, cnt)
      end
      else if dch = '&' then do
        if length(out) > 0 then do
          if right(out, 1) <> '0a'x then out = out || '0a'x
        end
        else if capdepth = 0 & outcol <> 0 then out = out || '0a'x
      end
      else if dch = '~' then do
        cnt = 1
        if pc >= 1 then cnt = pm[1]
        out = out || copies('~', cnt)
      end
      else if dch = '0a'x then do
        do while i <= len & (substr(ctl, i, 1) = ' ' | substr(ctl, i, 1) = '09'x)
          i = i + 1
        end
      end
      else if dch = '*' then do
        if colon = 1 then fidx = fidx - 1
        else fidx = fidx + 1
      end
      else if dch = '^' then do
        if fidx > fnn then do
          fstop = 1
          return out
        end
      end
      else if dch = '{' then do
        e = fmtfind(ctl, i)
        if e = 0 then return out || lerror('unterminated ~{ in FORMAT')
        body = substr(ctl, i, e - i)
        i = e + 2
        l = fmtarg(fav, fnn)
        if unw <> 0 then return out
        sub = .int[]
        sn = 0
        if at = 1 then do
          sn = fnn - fidx + 1
          do k = 1 to sn
            sub[k] = fav[fidx + k - 1]
          end
          fidx = fnn + 1
        end
        else do
          sn = list2arr(l, sub)
        end
        savei = fidx
        fidx = 1
        cnt = 0
        do while fidx <= sn
          before = fidx
          out = out || fmtrun(body, sub, sn)
          if unw <> 0 then return out
          if fstop = 1 then do
            fstop = 0
            leave
          end
          if fidx = before then leave
          cnt = cnt + 1
        end
        if at = 0 then fidx = savei
        else fidx = fnn + 1
      end
      else if dch = '[' then do
        e = fmtfind(ctl, i)
        if e = 0 then return out || lerror('unterminated ~[ in FORMAT')
        semis = fsemi
        /* split into clauses */
        cl = .string[]
        dflt = 0
        nc = 0
        st = i
        k = 1
        do while k <= words(semis)
          w = word(semis, k)
          isc = 0
          if right(w, 1) = 'c' then do
            isc = 1
            w = left(w, length(w) - 1)
          end
          p = w as .int
          nc = nc + 1
          cl[nc] = substr(ctl, st, p - st)
          if isc = 1 then dflt = nc + 1
          j = p + 1
          do while substr(ctl, j, 1) <> ';'
            j = j + 1
          end
          st = j + 1
          k = k + 1
        end
        nc = nc + 1
        cl[nc] = substr(ctl, st, e - st)
        i = e + 2
        v = fmtarg(fav, fnn)
        if unw <> 0 then return out
        pick = 0
        if colon = 1 then do
          if v = 1 then pick = 1
          else pick = 2
        end
        else if at = 1 then do
          if v = 1 then pick = 0
          else do
            pick = 1
            fidx = fidx - 1
          end
        end
        else do
          if v < 0 then pick = intval(v) + 1
          else pick = 0
          if pick < 1 | pick > nc then pick = dflt
        end
        if pick >= 1 & pick <= nc then out = out || fmtrun(cl[pick], fav, fnn)
      end
      else if dch = '(' then do
        e = fmtfind(ctl, i)
        if e = 0 then return out || lerror('unterminated ~( in FORMAT')
        body = substr(ctl, i, e - i)
        i = e + 2
        s = fmtrun(body, fav, fnn)
        if colon = 1 & at = 1 then s = upper(s)
        else if at = 1 then do
          s = lower(s)
          s = upper(left(s, 1)) || substr(s, 2)
        end
        else if colon = 1 then s = capitalize(s)
        else s = lower(s)
        out = out || s
      end
      else do
        return out || lerror('unknown FORMAT directive ~' || dch)
      end
    end
  end
  return out

capitalize: procedure = .string
  arg s = .string
  o = ''
  prev = ' '
  do k = 1 to length(s)
    c = substr(s, k, 1)
    if pos(prev, ' -_/.,;:!?()') > 0 then o = o || upper(c)
    else o = o || lower(c)
    prev = c
  end
  return o

/* FORMAT with the control string in av[from] and the arguments after it */
formatargs: procedure = .string
  arg expose av = .int[], from = .int, n = .int
  if isstring(av[from]) = 0 then do
    junk = lerror('FORMAT control is not a string')
    return ''
  end
  fa = .int[]
  k = 0
  do i = from + 1 to n
    k = k + 1
    fa[k] = av[i]
  end
  fidx = 1
  fstop = 0
  return fmtrun(cstr[av[from]], fa, k)


/* ===================================================================== */
/*                       HELPERS FOR THE BUILTINS                        */
/* ===================================================================== */
mkvec: procedure = .int
  arg expose a = .int[], n = .int
  v = newcell(9)
  cext[v] = nvdat + 1
  ccdr[v] = n
  cnum[v] = n * 1.0
  do i = 1 to n
    nvdat = nvdat + 1
    vdat[nvdat] = a[i]
  end
  return v

mkvecn: procedure = .int
  arg n = .int, init = .int
  v = newcell(9)
  cext[v] = nvdat + 1
  ccdr[v] = n
  cnum[v] = n * 1.0
  do i = 1 to n
    nvdat = nvdat + 1
    vdat[nvdat] = init
  end
  return v

/* sequence to array; returns the count */
seq2arr: procedure = .int
  arg s = .int, expose a = .int[]
  if s = 1 then return 0
  if iscons(s) = 1 then return list2arr(s, a)
  if s > 0 then do
    if ctag[s] = 9 then do
      n = ccdr[s]
      b = cext[s]
      do i = 1 to n
        a[i] = vdat[b + i - 1]
      end
      return n
    end
    if ctag[s] = 4 then do
      t = cstr[s]
      n = length(t)
      do i = 1 to n
        a[i] = mkchar(c2d(substr(t, i, 1)))
      end
      return n
    end
  end
  junk = lerrk('TYPE-ERROR', 'the value ' || printobj(s, 1) || ' is not a sequence')
  return 0

/* build a sequence like proto (list, vector, string) from an array */
arr2seq: procedure = .int
  arg proto = .int, expose a = .int[], n = .int
  if proto > 0 then do
    if ctag[proto] = 9 then return mkvec(a, n)
    if ctag[proto] = 4 then do
      s = ''
      do i = 1 to n
        if ischar(a[i]) = 1 then s = s || d2c(cext[a[i]])
      end
      return mkstr(s)
    end
  end
  return arr2list(a, 1, n)

/* index of the value of keyword argument kname at or after position from, 0 if absent */
kwidx: procedure = .int
  arg expose av = .int[], n = .int, from = .int, kname = .string
  kw = intern(':' || kname)
  j = from
  do while j < n
    if av[j] = kw then return j + 1
    j = j + 2
  end
  return 0

/* the :test / :key functions of a call; 0 means default */
kwfn: procedure = .int
  arg expose av = .int[], n = .int, from = .int, kname = .string
  j = kwidx(av, n, from, kname)
  if j = 0 then return 0
  if av[j] = 1 then return 0
  return fnof(av[j])

same: procedure = .int
  arg tf = .int, a = .int, b = .int
  if tf = 0 then return eql(a, b)
  if call2(tf, a, b) <> 1 then return 1
  return 0

keyed: procedure = .int
  arg kf = .int, x = .int
  if kf = 0 then return x
  return call1(kf, x)

strcmp: procedure = .int
  arg a = .string, b = .string
  la = length(a)
  lb = length(b)
  m = la
  if lb < m then m = lb
  do i = 1 to m
    x = c2d(substr(a, i, 1))
    y = c2d(substr(b, i, 1))
    if x < y then return -1
    if x > y then return 1
  end
  if la < lb then return -1
  if la > lb then return 1
  return 0

/* a string from a string designator */
strof: procedure = .string
  arg x = .int
  if x > 0 then do
    if ctag[x] = 4 then return cstr[x]
    if ctag[x] = 2 then return cstr[x]
    if ctag[x] = 8 then return d2c(cext[x])
  end
  junk = lerrk('TYPE-ERROR', 'the value ' || printobj(x, 1) || ' is not a string designator')
  return ''

isalpha: procedure = .int
  arg c = .int
  if c >= 65 & c <= 90 then return 1
  if c >= 97 & c <= 122 then return 1
  return 0

/* merge sort of av[1..n] with the predicate pf and key kf; stable */
msort: procedure = .void
  arg expose a = .int[], n = .int, pf = .int, kf = .int
  b = .int[]
  w = 1
  do while w < n
    i = 1
    do while i <= n
      lo = i
      mid = i + w
      hi = i + 2 * w
      if mid > n + 1 then mid = n + 1
      if hi > n + 1 then hi = n + 1
      l = lo
      r = mid
      k = lo
      do while l < mid & r < hi
        /* take from the right only when right < left */
        if call2(pf, keyed(kf, a[r]), keyed(kf, a[l])) <> 1 then do
          b[k] = a[r]
          r = r + 1
        end
        else do
          b[k] = a[l]
          l = l + 1
        end
        k = k + 1
        if unw <> 0 then return
      end
      do while l < mid
        b[k] = a[l]
        l = l + 1
        k = k + 1
      end
      do while r < hi
        b[k] = a[r]
        r = r + 1
        k = k + 1
      end
      i = i + 2 * w
    end
    do j = 1 to n
      a[j] = b[j]
    end
    w = w * 2
  end
  return

bitop: procedure = .int
  arg a = .int, b = .int, op = .int
  m = 4611686018427387904
  if a < 0 then a = a + m
  if b < 0 then b = b + m
  r = 0
  p = 1
  do k = 0 to 61
    x = a % 2
    y = b % 2
    a = a / 2
    b = b / 2
    z = 0
    if op = 1 then do
      if x = 1 & y = 1 then z = 1
    end
    else if op = 2 then do
      if x = 1 | y = 1 then z = 1
    end
    else do
      if x <> y then z = 1
    end
    if z = 1 then r = r + p
    p = p * 2
  end
  if r >= 2305843009213693952 then r = r - m
  return r

cxr: procedure = .int
  arg path = .string, x = .int
  do i = length(path) to 1 by -1
    if substr(path, i, 1) = 'A' then x = car(x)
    else x = cdr(x)
    if unw <> 0 then return 1
  end
  return x

/* copy a sequence range into an array of bounds checked indices */
subseqn: procedure = .int
  arg s = .int, st = .int, en = .int
  a = .int[]
  n = seq2arr(s, a)
  if unw <> 0 then return 1
  if en < 0 then en = n
  if st < 0 | st > en | en > n then return lerror('bad subsequence bounds ' || st || ' ' || en)
  b = .int[]
  k = 0
  do i = st + 1 to en
    k = k + 1
    b[k] = a[i]
  end
  return arr2seq(s, b, k)

/* position of item in array, 0 if absent */
findpos: procedure = .int
  arg expose a = .int[], n = .int, item = .int, tf = .int, kf = .int, fromend = .int
  if fromend = 1 then do
    do i = n to 1 by -1
      if same(tf, item, keyed(kf, a[i])) = 1 then return i
    end
    return 0
  end
  do i = 1 to n
    if same(tf, item, keyed(kf, a[i])) = 1 then return i
  end
  return 0

parseint: procedure = .int
  arg s = .string, junk = .int
  t = strip(s)
  if junk = 1 then do
    i = 1
    if left(t, 1) = '-' | left(t, 1) = '+' then i = 2
    j = i
    do while j <= length(t) & pos(substr(t, j, 1), '0123456789') > 0
      j = j + 1
    end
    if j = i then return 1
    t = left(t, j - 1)
  end
  if length(t) = 0 then return lerror('no integer in ' || printstring(s))
  if datatype(t, 'W') = '1' & pos('.', t) = 0 & pos('E', upper(t)) = 0 then do
    v = t as .int
    return mkint(v)
  end
  return lerror('junk in ' || printstring(s))

copytree: procedure = .int
  arg x = .int
  if iscons(x) = 0 then return x
  r = 1
  do while iscons(x) = 1
    r = cons(copytree(ccar[x]), r)
    x = ccdr[x]
  end
  r = nreverse(r)
  return r

subst: procedure = .int
  arg new = .int, old = .int, x = .int
  if eql(x, old) = 1 then return new
  if iscons(x) = 0 then return x
  return cons(subst(new, old, ccar[x]), subst(new, old, ccdr[x]))

/* one step of macro expansion; 0 if the form is not a macro call */
macroexp1: procedure = .int
  arg x = .int
  if iscons(x) = 0 then return 0
  f = ccar[x]
  if issym(f) = 0 then return 0
  fn = ccdr[f]
  if fn <= 1 then return 0
  if ctag[fn] <> 7 then return 0
  av = .int[]
  n = list2arr(ccdr[x], av)
  env = bindparams(ccar[fn], av, n, cext[fn])
  if unw <> 0 then return 1
  return evalbody(ccdr[fn], env)

isblank: procedure = .int
  arg s = .string
  do i = 1 to length(s)
    c = substr(s, i, 1)
    if c <> ' ' & c <> '0a'x & c <> '09'x & c <> '0d'x then return 0
  end
  return 1


/* ===================================================================== */
/*                        INITIALISATION AND DRIVER                      */
/* ===================================================================== */
sf: procedure = .void
  arg name = .string, id = .int
  s = intern(name)
  cext[s] = id
  return

defconst: procedure = .void
  arg name = .string, v = .int
  s = intern(name)
  ccar[s] = v
  cspec[s] = 2
  return

initlisp: procedure = .void
  maxdepth = 24000
  junk = intern('NIL')
  junk = intern('T')
  ccar[1] = 1
  ccdr[1] = 1
  ccar[2] = 2
  cspec[1] = 2
  cspec[2] = 2
  sQUOTE = intern('QUOTE')
  sFUNCTION = intern('FUNCTION')
  sQUASI = intern('QUASIQUOTE')
  sUNQ = intern('UNQUOTE')
  sUNQS = intern('UNQUOTE-SPLICING')
  sLAMBDA = intern('LAMBDA')
  sOPT = intern('&OPTIONAL')
  sREST = intern('&REST')
  sKEY = intern('&KEY')
  sAUX = intern('&AUX')
  sBODY = intern('&BODY')
  sELSE = intern('ELSE')
  sERROR = intern('ERROR')
  sTHEN = intern('THEN')
  sOTHERWISE = intern('OTHERWISE')
  sBLOCK = intern('BLOCK')
  sRETFROM = intern('RETURN-FROM')
  sRETURN = intern('RETURN')
  sXLOOP = intern('%LOOP')
  call sf 'QUOTE', 1
  call sf 'FUNCTION', 2
  call sf 'IF', 3
  call sf 'PROGN', 4
  call sf 'LOCALLY', 4
  call sf 'LET', 5
  call sf 'LET*', 6
  call sf 'COND', 7
  call sf 'CASE', 8
  call sf 'AND', 9
  call sf 'OR', 10
  call sf 'WHEN', 11
  call sf 'UNLESS', 12
  call sf 'ECASE', 13
  call sf 'LOOP', 14
  call sf 'SETQ', 21
  call sf 'DEFUN', 22
  call sf 'DEFVAR', 23
  call sf 'DEFPARAMETER', 24
  call sf 'DEFMACRO', 25
  call sf 'LAMBDA', 26
  call sf 'SETF', 27
  call sf 'INCF', 28
  call sf 'DECF', 29
  call sf 'PUSH', 30
  call sf 'POP', 31
  call sf 'DO', 32
  call sf 'DO*', 33
  call sf 'DOLIST', 34
  call sf 'DOTIMES', 35
  call sf 'FLET', 37
  call sf 'LABELS', 38
  call sf 'BLOCK', 39
  call sf 'RETURN-FROM', 40
  call sf 'RETURN', 41
  call sf 'CATCH', 42
  call sf 'THROW', 43
  call sf 'HANDLER-CASE', 44
  call sf 'IGNORE-ERRORS', 45
  call sf 'UNWIND-PROTECT', 46
  call sf 'QUASIQUOTE', 47
  call sf 'THE', 48
  call sf 'DECLARE', 49
  call sf 'DECLAIM', 49
  call sf 'PROCLAIM', 49
  call sf 'IN-PACKAGE', 49
  call sf 'DEFPACKAGE', 49
  call sf 'DEFSTRUCT', 50
  call sf 'DEFCONSTANT', 51
  call sf 'PUSHNEW', 52
  call sf 'ASSERT', 53
  call sf 'MULTIPLE-VALUE-BIND', 54
  call sf 'WITH-OUTPUT-TO-STRING', 55
  call sf 'PROG1', 56
  call sf 'PROG2', 57
  call sf 'DESTRUCTURING-BIND', 58
  call sf 'TYPECASE', 59
  call sf 'ETYPECASE', 59
  call sf 'TIME', 60
  call sf 'MULTIPLE-VALUE-LIST', 61
  call sf 'NTH-VALUE', 62
  call sf 'ROTATEF', 63
  call sf 'PSETQ', 64
  call defconst 'PI', mkfloat(3.14159265358979323846)
  call defconst 'MOST-POSITIVE-FIXNUM', mkint(4611686018427387903)
  call defconst 'MOST-NEGATIVE-FIXNUM', mkint(-4611686018427387903)
  call defconst 'INTERNAL-TIME-UNITS-PER-SECOND', mkint(1000)
  ccar[intern('*STANDARD-OUTPUT*')] = 2
  ccar[intern('*ERROR-OUTPUT*')] = 2
  ccar[intern('*STANDARD-INPUT*')] = 2
  ccar[intern('*PRINT-PRETTY*')] = 1
  return

registerprim: procedure = .void
  arg name = .string, id = .int, mn = .int, mx = .int
  s = intern(name)
  c = newcell(5)
  cext[c] = id
  cstr[c] = name
  ccdr[s] = c
  pmin[id] = mn
  pmax[id] = mx
  return

/* ------------------------------------------------------------- loading */
runsource: procedure = .int
  arg text = .string
  osrc = src
  orp = rp
  orl = rlen
  src = text
  rp = 1
  rlen = length(text)
  rc = 0
  do forever
    x = readobj()
    if unw <> 0 then do
      call reporterr
      rc = 1
      leave
    end
    if x = 0 then leave
    junk = eval(x, 1)
    if unw <> 0 then do
      call reporterr
      rc = 1
      leave
    end
  end
  src = osrc
  rp = orp
  rlen = orl
  return rc

loadfile: procedure = .int
  arg fname = .string
  fl = readlines(fname, 1, 0, 'noraise')
  if fl.0 >= 1 then do
    if fl[1] = '-8 OPEN ERROR' then do
      call emit 'Error: cannot open file ' || fname || '0a'x
      return 1
    end
  end
  s = ''
  do i = 1 to fl.0
    s = s || fl[i] || '0a'x
  end
  return runsource(s)

repl: procedure = .void
  buf = ''
  call emit '* '
  outcol = 0
  do while lines() > 0
    ln = linein()
    buf = buf || ln || '0a'x
    src = buf
    rp = 1
    rlen = length(buf)
    do forever
      eofflag = 0
      save = rp
      x = readobj()
      if unw <> 0 then do
        if eofflag = 1 then do
          unw = 0
          rp = save
          leave
        end
        call reporterr
        rp = rlen + 1
        leave
      end
      if x = 0 then do
        rp = rlen + 1
        leave
      end
      mvlist = 0
      r = eval(x, 1)
      if unw <> 0 then call reporterr
      else do
        call freshline
        call emit printobj(r, 1) || '0a'x
      end
    end
    buf = substr(buf, rp)
    if isblank(buf) = 1 then buf = ''
    if length(buf) = 0 then do
      call emit '* '
      outcol = 0
    end
  end
  call freshline
  return


/* ===================================================================== */
/*                          BUILTIN FUNCTIONS                            */
/* ===================================================================== */
/* CAR */
pf1: procedure = .int
  arg expose av = .int[], n = .int
  return car(av[1])
  return 1

/* CDR */
pf2: procedure = .int
  arg expose av = .int[], n = .int
  return cdr(av[1])
  return 1

/* CONS */
pf3: procedure = .int
  arg expose av = .int[], n = .int
  return cons(av[1], av[2])
  return 1

/* + */
pf4: procedure = .int
  arg expose av = .int[], n = .int
  if n = 2 then return numadd(av[1], av[2])
  r = mkint(0)
  do i = 1 to n
    r = numadd(r, av[i])
  end
  return r
  return 1

/* - */
pf5: procedure = .int
  arg expose av = .int[], n = .int
  if n = 1 then return numneg(av[1])
  r = av[1]
  do i = 2 to n
    r = numsub(r, av[i])
  end
  return r
  return 1

/* * */
pf6: procedure = .int
  arg expose av = .int[], n = .int
  r = mkint(1)
  do i = 1 to n
    r = nummul(r, av[i])
  end
  return r
  return 1

/* / */
pf7: procedure = .int
  arg expose av = .int[], n = .int
  if n = 1 then return numdiv(mkint(1), av[1])
  r = av[1]
  do i = 2 to n
    r = numdiv(r, av[i])
  end
  return r
  return 1

/* = */
pf8: procedure = .int
  arg expose av = .int[], n = .int
  do i = 1 to n - 1
    if numcmp(av[i], av[i + 1]) <> 0 then return 1
  end
  if unw <> 0 then return 1
  return 2
  return 1

/* < */
pf9: procedure = .int
  arg expose av = .int[], n = .int
  do i = 1 to n - 1
    if numcmp(av[i], av[i + 1]) >= 0 then return 1
  end
  return 2
  return 1

/* > */
pf10: procedure = .int
  arg expose av = .int[], n = .int
  do i = 1 to n - 1
    if numcmp(av[i], av[i + 1]) <= 0 then return 1
  end
  return 2
  return 1

/* <= */
pf11: procedure = .int
  arg expose av = .int[], n = .int
  do i = 1 to n - 1
    if numcmp(av[i], av[i + 1]) > 0 then return 1
  end
  return 2
  return 1

/* >= */
pf12: procedure = .int
  arg expose av = .int[], n = .int
  do i = 1 to n - 1
    if numcmp(av[i], av[i + 1]) < 0 then return 1
  end
  return 2
  return 1

/* /= */
pf13: procedure = .int
  arg expose av = .int[], n = .int
  if numcmp(av[1], av[2]) = 0 then return 1
  return 2
  return 1

/* 1+ */
pf14: procedure = .int
  arg expose av = .int[], n = .int
  return numadd(av[1], mkint(1))
  return 1

/* 1- */
pf15: procedure = .int
  arg expose av = .int[], n = .int
  return numsub(av[1], mkint(1))
  return 1

/* NULL NOT */
pf16: procedure = .int
  arg expose av = .int[], n = .int
  if av[1] = 1 then return 2
  return 1
  return 1

/* EQ */
pf17: procedure = .int
  arg expose av = .int[], n = .int
  if av[1] = av[2] then return 2
  return 1
  return 1

/* EQL */
pf18: procedure = .int
  arg expose av = .int[], n = .int
  return truth(eql(av[1], av[2]))
  return 1

/* EQUAL */
pf19: procedure = .int
  arg expose av = .int[], n = .int
  return truth(equal(av[1], av[2]))
  return 1

/* EQUALP */
pf20: procedure = .int
  arg expose av = .int[], n = .int
  return truth(equalp(av[1], av[2]))
  return 1

/* LIST */
pf21: procedure = .int
  arg expose av = .int[], n = .int
  return arr2list(av, 1, n)
  return 1

/* LIST* */
pf22: procedure = .int
  arg expose av = .int[], n = .int
  r = av[n]
  do i = n - 1 to 1 by -1
    r = cons(av[i], r)
  end
  return r
  return 1

/* ATOM */
pf23: procedure = .int
  arg expose av = .int[], n = .int
  return truth(1 - iscons(av[1]))
  return 1

/* CONSP */
pf24: procedure = .int
  arg expose av = .int[], n = .int
  return truth(iscons(av[1]))
  return 1

/* LISTP */
pf25: procedure = .int
  arg expose av = .int[], n = .int
  if av[1] = 1 | iscons(av[1]) = 1 then return 2
  return 1
  return 1

/* SYMBOLP */
pf26: procedure = .int
  arg expose av = .int[], n = .int
  return truth(issym(av[1]))
  return 1

/* STRINGP */
pf27: procedure = .int
  arg expose av = .int[], n = .int
  return truth(isstring(av[1]))
  return 1

/* NUMBERP REALP */
pf28: procedure = .int
  arg expose av = .int[], n = .int
  return truth(isnum(av[1]))
  return 1

/* INTEGERP RATIONALP */
pf29: procedure = .int
  arg expose av = .int[], n = .int
  return truth(isint(av[1]))
  return 1

/* FLOATP */
pf30: procedure = .int
  arg expose av = .int[], n = .int
  return truth(isfloat(av[1]))
  return 1

/* CHARACTERP */
pf31: procedure = .int
  arg expose av = .int[], n = .int
  return truth(ischar(av[1]))
  return 1

/* FUNCTIONP */
pf32: procedure = .int
  arg expose av = .int[], n = .int
  x = av[1]
  if x > 0 then do
    if ctag[x] = 5 | ctag[x] = 6 then return 2
  end
  return 1
  return 1

/* VECTORP */
pf33: procedure = .int
  arg expose av = .int[], n = .int
  x = av[1]
  if x > 0 then do
    if ctag[x] = 9 | ctag[x] = 4 then return 2
  end
  return 1
  return 1

/* ARRAYP SIMPLE-VECTOR-P */
pf34: procedure = .int
  arg expose av = .int[], n = .int
  x = av[1]
  if x > 0 then do
    if ctag[x] = 9 then return 2
  end
  return 1
  return 1

/* HASH-TABLE-P */
pf35: procedure = .int
  arg expose av = .int[], n = .int
  x = av[1]
  if x > 0 then do
    if ctag[x] = 10 then return 2
  end
  return 1
  return 1

/* KEYWORDP */
pf36: procedure = .int
  arg expose av = .int[], n = .int
  return truth(typep(av[1], intern('KEYWORD')))
  return 1

/* ZEROP */
pf37: procedure = .int
  arg expose av = .int[], n = .int
  return truth(numcmp(av[1], mkint(0)) = 0)
  return 1

/* PLUSP */
pf38: procedure = .int
  arg expose av = .int[], n = .int
  return truth(numcmp(av[1], mkint(0)) > 0)
  return 1

/* MINUSP */
pf39: procedure = .int
  arg expose av = .int[], n = .int
  return truth(numcmp(av[1], mkint(0)) < 0)
  return 1

/* EVENP */
pf40: procedure = .int
  arg expose av = .int[], n = .int
  if av[1] >= 0 then return lerrk('TYPE-ERROR', 'the value ' || printobj(av[1], 1) || ' is not an INTEGER')
  return truth(intval(av[1]) % 2 = 0)
  return 1

/* ODDP */
pf41: procedure = .int
  arg expose av = .int[], n = .int
  if av[1] >= 0 then return lerrk('TYPE-ERROR', 'the value ' || printobj(av[1], 1) || ' is not an INTEGER')
  return truth(intval(av[1]) % 2 <> 0)
  return 1

/* FIRST */
pf42: procedure = .int
  arg expose av = .int[], n = .int
  return car(av[1])
  return 1

/* REST */
pf43: procedure = .int
  arg expose av = .int[], n = .int
  return cdr(av[1])
  return 1

/* CAAR CADR CDAR CDDR CAAAR CAADR CADAR CADDR CDAAR CDADR CDDAR CDDDR CADDDR CDDDDR */
pf44: procedure = .int
  arg expose av = .int[], n = .int
  nm = cstr[curfn]
  return cxr(substr(nm, 2, length(nm) - 2), av[1])
  return 1

/* SECOND */
pf45: procedure = .int
  arg expose av = .int[], n = .int
  return car(cdr(av[1]))
  return 1

/* THIRD */
pf46: procedure = .int
  arg expose av = .int[], n = .int
  return car(cdr(cdr(av[1])))
  return 1

/* FOURTH */
pf47: procedure = .int
  arg expose av = .int[], n = .int
  return car(cdr(cdr(cdr(av[1]))))
  return 1

/* FIFTH */
pf48: procedure = .int
  arg expose av = .int[], n = .int
  return car(cdr(cdr(cdr(cdr(av[1])))))
  return 1

/* NTH */
pf49: procedure = .int
  arg expose av = .int[], n = .int
  l = av[2]
  k = toint(av[1])
  do while k > 0 & iscons(l) = 1
    l = ccdr[l]
    k = k - 1
  end
  return car(l)
  return 1

/* NTHCDR */
pf50: procedure = .int
  arg expose av = .int[], n = .int
  l = av[2]
  k = toint(av[1])
  do while k > 0 & iscons(l) = 1
    l = ccdr[l]
    k = k - 1
  end
  return l
  return 1

/* LENGTH */
pf51: procedure = .int
  arg expose av = .int[], n = .int
  x = av[1]
  if x = 1 then return mkint(0)
  if iscons(x) = 1 then return mkint(listlen(x))
  if x > 0 then do
    if ctag[x] = 4 then return mkint(length(cstr[x]))
    if ctag[x] = 9 then return mkint(ccdr[x])
    if ctag[x] = 10 then return mkint(ccdr[x])
  end
  return lerrk('TYPE-ERROR', 'the value ' || printobj(x, 1) || ' is not a sequence')
  return 1

/* APPEND */
pf52: procedure = .int
  arg expose av = .int[], n = .int
  if n = 0 then return 1
  r = av[n]
  do i = n - 1 to 1 by -1
    r = append2(av[i], r)
  end
  return r
  return 1

/* NCONC */
pf53: procedure = .int
  arg expose av = .int[], n = .int
  r = 1
  do i = n to 1 by -1
    if av[i] <> 1 then do
      if r = 1 then r = av[i]
      else do
        p = av[i]
        do while iscons(ccdr[p]) = 1
          p = ccdr[p]
        end
        ccdr[p] = r
        r = av[i]
      end
    end
  end
  return r
  return 1

/* REVERSE */
pf54: procedure = .int
  arg expose av = .int[], n = .int
  x = av[1]
  if x = 1 | iscons(x) = 1 then return reverse(x)
  a = .int[]
  k = seq2arr(x, a)
  b = .int[]
  do i = 1 to k
    b[i] = a[k - i + 1]
  end
  return arr2seq(x, b, k)
  return 1

/* NREVERSE */
pf55: procedure = .int
  arg expose av = .int[], n = .int
  x = av[1]
  if x = 1 | iscons(x) = 1 then return nreverse(x)
  a = .int[]
  k = seq2arr(x, a)
  b = .int[]
  do i = 1 to k
    b[i] = a[k - i + 1]
  end
  return arr2seq(x, b, k)
  return 1

/* LAST */
pf56: procedure = .int
  arg expose av = .int[], n = .int
  l = av[1]
  k = 1
  if n = 2 then k = toint(av[2])
  m = listlen(l)
  do while m > k
    l = ccdr[l]
    m = m - 1
  end
  return l
  return 1

