  j = kwidx(av, n, 3, 'FROM-END')
  if j > 0 then do
    if av[j] <> 1 then fe = 1
  end
  p = findpos(a, k, av[1], tf, kf, fe)
  if p = 0 then return 1
  return mkint(p - 1)
  return 1

