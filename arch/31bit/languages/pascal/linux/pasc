#!/bin/sh
# pasc -- Pascal in cREXX (github.com/mikebeer/pascal) on VM/370plus Linux
#   pasc prog.pas [args]     compile and run
#   pasc -c prog.pas         compile only (prog.rxas, prog.rxbin)
P=/usr/local/share/pascal
ONLY=0
if [ "$1" = "-c" ]; then ONLY=1; shift; fi
if [ -z "$1" ] || [ ! -f "$1" ]; then echo "usage: pasc [-c] program.pas" >&2; exit 2; fi
SRC=$1; shift; STEM=${SRC%.pas}
/usr/local/bin/rxvm $P/pascal.rxbin -a "$SRC" "$STEM.rxas" || exit 1
/usr/local/bin/rxas "$STEM" || exit 1
[ $ONLY = 1 ] && exit 0
exec /usr/local/bin/rxvm "$STEM.rxbin" $P/pasrt.rxbin -a "$@"
