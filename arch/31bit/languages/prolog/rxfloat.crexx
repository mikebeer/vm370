/* rxfloat.crexx -- VM/370+: the part of the rxfloat plugin prolog.crexx
   uses (sqrt), in REXX, so Prolog runs where the native plugin is not
   linked in (CMS) */
options levelb
namespace rxfloat expose sqrt

sqrt: procedure = .float
  arg value = .float
  if value <= 0 then return 0
  x = value
  if x < 1 then x = 1
  do 200
    y = (x + value / x) / 2
    if y >= x then leave
    x = y
  end
  return x
