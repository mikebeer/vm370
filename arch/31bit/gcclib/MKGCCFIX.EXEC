&CONTROL CMS
* MKGCCFIX EXEC -- rebuild GCCLIB/GCCRES TXTLIB and GCCLIB TEXT from the
* TEXT decks on H after CMSSYS changed (M5b: mode-independent SSM).
* The library steps of MKGCCLIB EXEC, without the C compiles.
GLOBAL MACLIB GCCLIB CMSHRC CMSLIB
&SDISK = H
&VDISK = H
ASSEMBLE CMSENTRY (LIST)
&IF &RETCODE NE 0 &EXIT &RETCODE
COPYFILE CMSENTRY TEXT    &SDISK CMSENTNR = = (OLDDATE REPLACE)
ASSEMBLE CMSENTRY (LIST SYSPARM(RES))
&IF &RETCODE NE 0 &EXIT &RETCODE
COPYFILE CMSENTRY TEXT    &SDISK CMSENTRS = = (OLDDATE REPLACE)
ERASE    CMSENTRY TEXT    &SDISK
ERASE    CMSENTRY LISTING &SDISK
TXTLIB GEN GCCLIB CMSENTNR
TXTLIB ADD GCCLIB CMSRTSTB
TXTLIB ADD GCCLIB CMSRUNTM
TXTLIB ADD GCCLIB CMSRUNTA
TXTLIB ADD GCCLIB DYNSTK
TXTLIB ADD GCCLIB CMSJUMP
TXTLIB ADD GCCLIB CMSIO
TXTLIB ADD GCCLIB CONDRV
TXTLIB ADD GCCLIB PUNDRV
TXTLIB ADD GCCLIB PRTDRV
TXTLIB ADD GCCLIB RDRDRV
TXTLIB ADD GCCLIB DSKDRV
TXTLIB ADD GCCLIB CMSSTDIO
TXTLIB ADD GCCLIB CMSSTDLB
TXTLIB ADD GCCLIB MALLOC
TXTLIB ADD GCCLIB CMSSYSC
TXTLIB ADD GCCLIB CMSSYS
TXTLIB ADD GCCLIB ASSERT
TXTLIB ADD GCCLIB CTYPE
TXTLIB ADD GCCLIB LOCALE
TXTLIB ADD GCCLIB MATH
TXTLIB ADD GCCLIB SIGNAL
TXTLIB ADD GCCLIB STRING
TXTLIB ADD GCCLIB TIME
TXTLIB ADD GCCLIB REXXSAA
TXTLIB GEN GCCRES CMSENTRS
TXTLIB ADD GCCRES RESLIBI
TXTLIB ADD GCCRES CMSRTSTB
TXTLIB ADD GCCRES DYNSTK
ASSEMBLE CMSSTUBS (LIST)
&IF &RETCODE GT 4 &EXIT &RETCODE
TXTLIB ADD GCCRES CMSSTUBS
ASSEMBLE CMSVTAB (NOLIST NOTERM)
&IF &RETCODE GT 4 &EXIT &RETCODE
COPYFILE CMSVTAB  TEXT &VDISK GCCLIB TEXT A (REPLACE)
&IF &RETCODE NE 0 &EXIT &RETCODE
&RESULT = 0
COPYFILE RESMAIN TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
COPYFILE CMSRUNTM TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
COPYFILE CMSRUNTA TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
COPYFILE DYNSTK TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
COPYFILE CMSJUMP TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
COPYFILE CMSIO TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
COPYFILE CONDRV TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
COPYFILE PUNDRV TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
COPYFILE PRTDRV TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
COPYFILE RDRDRV TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
COPYFILE DSKDRV TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
COPYFILE CMSSTDIO TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
COPYFILE CMSSTDLB TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
COPYFILE MALLOC TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
COPYFILE CMSSYSC TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
COPYFILE CMSSYS TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
COPYFILE ASSERT TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
COPYFILE CTYPE TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
COPYFILE LOCALE TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
COPYFILE MATH TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
COPYFILE SIGNAL TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
COPYFILE STRING TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
COPYFILE TIME TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
COPYFILE REXXSAA TEXT &SDISK GCCLIB TEXT A (APPEND)
&IF &RETCODE NE 0 &RESULT = &RETCODE
&IF &RESULT NE 0 &EXIT &RESULT
GLOBAL TXTLIB GCCRES
LOAD GCCLIB (MAP)
&IF &RETCODE NE 0 &EXIT &RETCODE
COPYFILE LOAD MAP A GCCLIB MAP A (OLDDATE REPLACE)
ERASE LOAD MAP A
GLOBAL TXTLIB
&TYPE MKGCCFIX DONE
&EXIT 0
