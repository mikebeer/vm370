/* CRXMK31 EXEC -- cREXX (2022 S370 tree) as AMODE 31 programs, built  */
/* on VM/370+ (M5g): GCC380 with GCCLIB31's headers and macros (G disk, */
/* LIB GCC31), linked with GCCLIB31 TXTLIB.  Sources copied from D to F; */
/* modules RXCN, RXASN, RXBVMN, RXDASN on A beside the 24-bit ones on E. */
SOURCE_DISK = 'F'
BUILD_RESULT = 0
'COPYFILE * C D = = F (REPLACE'
'COPYFILE * H D = = F (REPLACE'
'COPYFILE CREXX PARM D = = F (REPLACE'
/* D HOLDS THE 24-BIT BUILD'S TEXT DECKS, AND LOAD TAKES THE FIRST IN    */
/* SEARCH ORDER: OUT OF THE WAY UNTIL THE MODULES ARE BUILT              */
'RELEASE D'
'GLOBAL TXTLIB GCCLIB31'
CALL BUILD
'ACCESS 192 D'
SAY "RXCN -V";   'RXCN -V'
SAY "RXASN -V";  'RXASN -V'
SAY "RXDASN -V"; 'RXDASN -V'
SAY "RXBVMN -V"; 'RXBVMN -V'
IF BUILD_RESULT > 0 THEN SAY "***** THERE WERE BUILD ERRORS *****"
EXIT BUILD_RESULT

BUILD: PROCEDURE EXPOSE SOURCE_DISK RESULT BUILD_RESULT
  PARM = "CREXX"
  RESULT = 0
  CALL COMPILE "CMSUTIL"
  CALL COMPILE "AVL_TREE"
  CALL COMPILE "RXVMINST"
  IF BUILD_RESULT > 0 THEN RETURN
  /* COMPILER */
  RESULT = 0
  CALL COMPILE "RXCPMAIN"
  CALL COMPILE "RXCPAST"
  CALL COMPILE "RXCPOSCN"
  CALL COMPILE "RXCPOPGR"
  CALL COMPILE "RXCPOPAR"
  CALL COMPILE "REXBSCAN"
  CALL COMPILE "RXCPBGMR"
  CALL COMPILE "RXCPBPAR"
  CALL COMPILE "RXCPBVAL"
  CALL COMPILE "RXCPSYMB"
  CALL COMPILE "RXCPEMIT"
  CALL COMPILE "RXCP_OPT"
  IF RESULT = 0 THEN CALL LINK "RXCN",
    "RXCPMAIN RXCPAST RXCPOSCN RXCPOPGR RXCPOPAR REXBSCAN RXCPBGMR",
    "RXCPBPAR RXCPBVAL RXCPSYMB RXCP_OPT RXCPEMIT RXVMINST AVL_TREE",
    "CMSUTIL"
  /* ASSEMBLER */
  RESULT = 0
  CALL COMPILE "RXASSCAN"
  CALL COMPILE "RXASGRMR"
  CALL COMPILE "RXASMAIN"
  CALL COMPILE "RXASTOKE"
  CALL COMPILE "RXASEROR"
  CALL COMPILE "RXASASSM"
  CALL COMPILE "RXAS_OPT"
  IF RESULT = 0 THEN CALL LINK "RXASN",
    "RXASSCAN RXASGRMR RXASMAIN RXASTOKE RXASEROR RXASASSM RXVMINST",
    "RXAS_OPT AVL_TREE CMSUTIL"
  /* BYTECODE INTERPRETER -- 'Out of memory - todo' on stock CE */
  RESULT = 0
  CALL COMPILE "RXVMMAIN"
  CALL COMPILE "RXVMINTP"
  CALL COMPILE "RXVMLOAD"
  IF RESULT = 0 THEN CALL LINK "RXBVMN",
    "RXVMMAIN RXVMINTP RXVMLOAD RXVMINST AVL_TREE CMSUTIL"
  /* DISASSEMBLER */
  RESULT = 0
  CALL COMPILE "RXDAMAIN"
  CALL COMPILE "RXDADISM"
  IF RESULT = 0 THEN CALL LINK "RXDASN",
    "RXDAMAIN RXDADISM RXVMINST AVL_TREE CMSUTIL"
RETURN

LINK: PROCEDURE EXPOSE BUILD_RESULT
  PARSE ARG NAME TEXTS
  SAY "LINKING" NAME
  "LOAD" TEXTS
  IF RC > 0 THEN BUILD_RESULT = RC
  "GENMOD" NAME
  IF RC > 0 THEN BUILD_RESULT = RC
RETURN

COMPILE: PROCEDURE EXPOSE SOURCE_DISK RESULT PARM BUILD_RESULT
  ARG FILE
  SAY "COMPILING" FILE
  "EXEC GCC31" FILE "C" SOURCE_DISK "( LIB GCC31 PARM" PARM
  IF RC > 0 THEN RESULT = RC
  IF RESULT > 0 THEN BUILD_RESULT = RESULT
RETURN
