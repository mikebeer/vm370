/* GCLB31 EXEC -- build GCCLIB31 TXTLIB on VM/370+ (M5g)              */
/* Sources (mk31.py output) on the A disk.  Assembler stubs with      */
/* ASSEMBLE, C with GCC370 and the GCC31 MACLIB, so the headers and   */
/* macros are these, not GCCCMS 202's.                                */
FILES = 'CMSRTSTB CMSRUNTM CMSIO CONDRV PUNDRV PRTDRV RDRDRV DSKDRV',
        'CMSSTDIO CMSSTDLB MALLOC CMSSYSC ASSERT CTYPE LOCALE MATH',
        'SIGNAL STRING TIME REXXSAA'
ASMS  = 'CMSENTRY CMSRUNTA DYNSTK CMSJUMP CMSSYS'
BAD = 0
'MACLIB GEN GCC31 CMSCRAB GCCCRAB PDPEPIL PDPPRLG PDPTOP VTENTRY VTABLE'
IF RC <> 0 THEN EXIT RC
'GLOBAL MACLIB GCC31 DMSGPI CMSHRC CMSLIB OSMACRO TSOMAC'
DO I = 1 TO WORDS(ASMS)
  F = WORD(ASMS, I)
  SAY 'GCLB31: ASSEMBLE' F
  'ASSEMBLE' F '(NOLIST'
  IF RC > 4 THEN DO; SAY 'GCLB31: RC' RC 'FROM ASSEMBLE' F; BAD = BAD + 1; END
END
DO I = 1 TO WORDS(FILES)
  F = WORD(FILES, I)
  SAY 'GCLB31: GCC' F
  CALL COMPILE F
  IF RESULT > 4 THEN DO; SAY 'GCLB31: RC' RESULT 'FROM' F; BAD = BAD + 1; END
END
IF BAD > 0 THEN DO; SAY 'GCLB31:' BAD 'FAILED'; EXIT 8; END
ALL = ASMS FILES
'ERASE GCCLIB31 TXTLIB A'
'TXTLIB GEN GCCLIB31 CMSENTRY'
DO I = 2 TO WORDS(ALL)
  'TXTLIB ADD GCCLIB31' WORD(ALL, I)
  IF RC <> 0 THEN BAD = BAD + 1
END
SAY 'GCLB31: GCCLIB31 TXTLIB BUILT, ' BAD 'TXTLIB ERRORS'
EXIT BAD

/* GCC370 (THE 24-BIT COMPILER): ITS OUTPUT IS THE SAME AS GCC380'S   */
/* (WHICH ABENDED 80A HERE UNTIL I-252).  THE CSECT IS NAMED WITH     */
/* EDIT: TXTLIB REFUSES UNNAMED CSECTS, AND GCCCSECT TOOK AN          */
/* OPERATION EXCEPTION AT 000002 WHEN RUN FROM THIS EXEC (W264).      */
COMPILE: PROCEDURE
  ARG F
  'ERASE' F 'WORK A'
  'FILEDEF SYSPRINT TERM (LRECL 80'
  'FILEDEF SYSTERM TERM (LRECL 80'
  'FILEDEF SYSPARM DISK GCLB31 PARM A'
  'FILEDEF OUT DISK' F 'WORK A (LRECL 80 RECFM F'
  'FILEDEF SYSIN DISK' F 'C A'
  'GCC370'
  R = RC
  'FILEDEF SYSPRINT CLEAR'
  'FILEDEF SYSTERM CLEAR'
  'FILEDEF SYSPARM CLEAR'
  'FILEDEF OUT CLEAR'
  'FILEDEF SYSIN CLEAR'
  IF R > 4 THEN RETURN R
  'ERASE' F 'ASSEMBLE A'
  'RENAME' F 'WORK A = ASSEMBLE ='
  /* NAME THE CSECT (TXTLIB REFUSES PRIVATE CODE), AS GCCCSECT WOULD */
  'MAKEBUF'
  QUEUE 'SERIAL OFF'
  QUEUE 'LOCATE /         CSECT/'
  /* '$' + NAME: CSECT TIME WOULD CLASH WITH FUNCTION TIME (IFO196) */
  QUEUE 'CHANGE /         CSECT/'LEFT('$'LEFT(F, 7), 9)'CSECT/'
  QUEUE 'FILE'
  'EDIT' F 'ASSEMBLE A'
  E = RC
  'DROPBUF'
  IF E <> 0 THEN RETURN 100 + E
  'ASMAHL' F '(NOTERM'
  IF RC <> 0 THEN RETURN 200 + RC
  'ERASE' F 'LISTING A'
RETURN 0
