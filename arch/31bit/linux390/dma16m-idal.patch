diff --git a/arch/s390/include/asm/idals.h b/arch/s390/include/asm/idals.h
index ea5a6e45..8117fc2a 100644
--- a/arch/s390/include/asm/idals.h
+++ b/arch/s390/include/asm/idals.h
@@ -35,7 +35,9 @@ idal_is_needed(void *vaddr, unsigned int length)
 #ifdef CONFIG_64BIT
 	return ((__pa(vaddr) + length - 1) >> 31) != 0;
 #else
-	return 0;
+	/* VM/370+: a guest channel program is run as format 0, whose data
+	 * addresses have 24 bits -- data above 16 MB goes through an IDAL */
+	return ((__pa(vaddr) + length - 1) >> 24) != 0;
 #endif
 }
 
