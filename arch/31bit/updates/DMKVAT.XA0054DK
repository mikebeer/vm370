         BC    2,VXW05                                         XA0054DK         
         L     R4,0(,R2)      GUEST STE                        XA0054DK         
         LR    R0,R4                                           XA0054DK         
         N     R0,=X'00000020'                                 XA0054DK         
         BNZ   VXW10                                           XA0054DK         
         LTR   R4,R4                                           XA0054DK         
         BM    VXW12                                           XA0054DK         
         LR    R1,R7                                           XA0054DK         
         SRL   R1,12                                           XA0054DK         
         N     R1,=F'255'     PAGE INDEX                       XA0054DK         
         LR    R0,R4                                           XA0054DK         
         N     R0,=F'15'                                       XA0054DK         
         A     R0,=F'1'       (NOT LA: BASE 0 IS NO REGISTER)  XA0054DK         
         SLL   R0,4                                            XA0054DK         
         CR    R1,R0                                           XA0054DK         
         BNL   VXW11                                           XA0054DK         
         SLL   R1,2                                            XA0054DK         
         N     R4,=X'7FFFFFC0'                                 XA0054DK         
         AR    R1,R4                                           XA0054DK         
