./ R 02667100 02667450 $ 02667110 010                                           
*  M5D: GETMAIN/FREEMAIN RU (SVC 120).  R0 = LENGTH, R1 =      XA0051DK         
*  ADDRESS (FREEMAIN), R15 FLAGS: X'01' = FREEMAIN (GCC380:    XA0051DK         
*  X'72' GET, X'03' FREE; W209).  ABOVE THE LINE FROM          XA0051DK         
*  HIGHSTOR FOR AN AMODE 31 CALLER (LOC=ANY); EVERYTHING ELSE  XA0051DK         
*  IS AN ORDINARY GETMAIN/FREEMAIN R, HANDED TO DMSSMN10 AS    XA0051DK         
*  THE SVC 10 DISPATCH WOULD (I-245).                          XA0051DK         
         L     R6,OSTEMP          TEMPSPC (REENTRANT WORK)     XA0051DK         
         STM   R0,R1,S120R0-TEMPSPC(R6)                        XA0051DK         
         MVC   S120PL-TEMPSPC(8,R6),=CL8'HIGHSTOR'             XA0051DK         
         MVC   S120PL+16-TEMPSPC(8,R6),S120R0-TEMPSPC(R6)      XA0051DK         
         TM    EGPR15+3,X'01'     FREEMAIN?                    XA0051DK         
         BZ    S120GET                                         XA0051DK         
         CL    R1,=A(X'01000000') ABOVE THE LINE?              XA0051DK         
         BL    S120LOW            NO: DMSSMN'S STORAGE         XA0051DK         
         MVC   S120PL+8-TEMPSPC(8,R6),=CL8'RELEASE'            XA0051DK         
         B     S120HS                                          XA0051DK         
S120GET  TM    OLDPSW+4,X'80'     CALLER IN AMODE 31?          XA0051DK         
         BZ    S120LOWG           NO: BELOW THE LINE           XA0051DK         
         MVC   S120PL+8-TEMPSPC(8,R6),=CL8'OBTAIN'             XA0051DK         
S120HS   LA    R1,S120PL-TEMPSPC(,R6)                          XA0051DK         
         SVC   202                                             XA0051DK         
         DC    AL4(S120ERR)                                    XA0051DK         
         L     R1,S120PL+20-TEMPSPC(R6)  THE ADDRESS           XA0051DK         
         ST    R1,EGPR1           FOR THE CALLER               XA0051DK         
         SR    R15,R15                                         XA0051DK         
         B     CMSRET                                          XA0051DK         
S120ERR  TM    EGPR15+3,X'01'     FAILED FREEMAIN:             XA0051DK         
         BO    CMSRET             RC 4 (BAD RELEASE)           XA0051DK         
S120LOWG MVC   EGPR1,=X'80000000' SVC 10 GETMAIN: R1 BYTE 0    XA0051DK         
S120LOW  L     R1,OSTEMP          AS THE SVC 10 DISPATCH DOES  XA0051DK         
         L     R3,SAVR14-TEMPSPC(,R1)                          XA0051DK         
         LA    R0,TEMPLNT                                      XA0051DK         
         DMSFRET DWORDS=(0),LOC=(1),TYPCALL=BALR               XA0051DK         
         LR    R14,R3                                          XA0051DK         
         LM    R0,R1,EGPR0                                     XA0051DK         
         L     R12,=V(DMSSMN10)                                XA0051DK         
         BR    R12                                             XA0051DK         
./ R 02782000          $ 02782100 100                                           
S120R0   DS    F                  M5D: SVC 120 WORK            XA0051DK         
S120R1   DS    F                                               XA0051DK         
S120R15  DS    F                                               XA0051DK         
S120PL   DS    6F                 HIGHSTOR PLIST               XA0051DK         
TEMPSEND EQU   *                                               XA0051DK         
