./ I 00365000 $ 00365010 010                                                    
*  M7.10: IPL LINUX = SET ESA ON + IPL 250 (THE DEBIAN DISK)   XA0054DK         
*  DMKCFG IS PAGEABLE: IT MUST STAY IN ONE PAGE, SO THIS IS    XA0054DK         
*  SHORT AND HAS NO LITERALS                                   XA0054DK         
         LA    R15,5                                           XA0054DK         
         CR    R0,R15                                          XA0054DK         
         BNE   CFGNLNX                                         XA0054DK         
         CLC   0(5,R1),CFGLNXN                                 XA0054DK         
         BNE   CFGNLNX                                         XA0054DK         
         OI    VMLCLRSV,X'40'  ESA ON, PENDING (IPLSETR2)      XA0054DK         
         OI    VMFSTAT,VMESA390  AND NOW (LOGON)               XA0054DK         
         LA    R1,X'250'      THE DEBIAN DISK                  XA0054DK         
         B     CFGLNXS        IPL IT AS A DEVICE               XA0054DK         
CFGLNXN  DC    C'LINUX'                                        XA0054DK         
CFGNLNX  DS    0H                                              XA0054DK         
./ R 00373000          $ 00372100 100                                           
CFGLNXS  ST    R1,SAVEWRK2    SAVE VIRTUAL ADDRESS FOR LATER   XA0054DK         
./ I 00456000 $ 00456100 100                                                    
VMESA390 EQU   X'02'          VMFSTAT: ESA/390 MACHINE         XA0054DK         
         TM    VMOSTAT,VMSHR  I-235: IN A NAMED SYSTEM, THE    XA0054DK         
         BZ    CFGNSHR        SHARED COPIES MUST GO: CLEAR     XA0054DK         
         NI    SAVEWRK1,X'FF'-NOCLEAR                          XA0054DK         
CFGNSHR  DS    0H                                              XA0054DK         
./ I 00464100 $ 00464110 010                                                    
         TM    SAVEWRK1,NOCLEAR  CLEARED (NOT NOCLEAR)?        XA0054DK         
         BO    CFGSHX                                          XA0054DK         
         TM    VMOSTAT,VMSHR  I-235: ALL STORAGE IS GONE, SO   XA0054DK         
         BZ    CFGSHX       NO NAMED SYSTEM RUNS ANY MORE:     XA0054DK         
CFGSHV    ICM   R1,15,VMASSIST THE VMABLOKS GO, AND THE        XA0054DK         
         BZ    CFGSHW       COUNT AND VMSHR WITH THEM          XA0054DK         
         MVC   VMASSIST,0(R1) (VMAFPNT)                        XA0054DK         
         LA    R0,2           (VMASIZE)                        XA0054DK         
         CALL  DMKFRET                                         XA0054DK         
         B     CFGSHV                                          XA0054DK         
CFGSHW    XC    VMSHRSYS,VMSHRSYS                              XA0054DK         
         NI    VMOSTAT,255-VMSHR                               XA0054DK         
CFGSHX    DS    0H                                             XA0054DK         
         TM    VMLCLRSV,X'40'  M7.8: SET ESA ON PENDING: THIS  XA0054DK         
         BZ    CFGESAX        DEVICE IPLS AN ESA/390 MACHINE   XA0054DK         
         OI    VMFSTAT,VMESA390                                XA0054DK         
CFGESAX  DS    0H                                              XA0054DK         
./ I 00472000 $ 00472100 100                                                    
*  M7.10: AN ESA/390 IPL OF A DISK MAY LOAD A WHOLE KERNEL     XA0054DK         
*  BY ITS IPL CHANNEL PROGRAM (VMZIPL): DMKVMI GOES TO THE     XA0054DK         
*  LAST PAGE BELOW 16 MB, OUT OF ITS WAY, WHEN THERE IS ONE    XA0054DK         
         TM    VMFSTAT,VMESA390                                XA0054DK         
         BZ    CFGVMI1                                         XA0054DK         
         CLC   VMSIZE,=X'01000000'                             XA0054DK         
         BL    CFGVMI1                                         XA0054DK         
         L     R1,=X'00FFF000'                                 XA0054DK         
CFGVMI1  DS    0H                                              XA0054DK         
./ I 00512000 $ 00512110 010                                                    
         TM    VMFSTAT,VMESA390  M7: ESA/390 GUEST: THE        XA0054DK         
         BZ    CFGNESA        IPL DEVICE'S SUBSYSTEM ID        XA0054DK         
         L     R1,SAVEWRK2    AT X'B8' (DMKVMI KEEPS IT)       XA0054DK         
         L     R15,=V(DMKVCSSN)                                XA0054DK         
         BALR  R14,R15        R1 = ITS SUBCHANNEL              XA0054DK         
         O     R1,=X'00010000'                                 XA0054DK         
         ST    R1,184(,R2)                                     XA0054DK         
         XC    188(4,R2),188(R2)                               XA0054DK         
CFGNESA  DS    0H                                              XA0054DK         
./ I 00558000 $ 00558010 010                                                    
         NI    VMFSTAT,X'FF'-VMESA390  M7.8: A NAMED SYSTEM    XA0054DK         
*                             (CMS) IS S/370; SET ESA ON       XA0054DK         
*                             STAYS PENDING                    XA0054DK         
